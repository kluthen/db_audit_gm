#!/usr/bin/env python3
"""A `docker` stand-in for the unit tests: put first on PATH by
run_gmctl, it answers as tools.tests.FakeDocker does (what the
tests set in DBAGM_FAKE_DOCKER_MISSING and DBAGM_FAKE_DOCKER_UNREACHABLE
shapes its engine), so gmctl run as a process never reaches a real engine.
"""

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[3]))

from tools.tests import FakeDocker  # noqa: E402


def main(argv):
    endpoint = argv[1] if argv[:1] == ["-H"] else None
    args = argv[2:] if endpoint else argv
    proc = FakeDocker.from_environment(endpoint).run(args, check=False)
    sys.stdout.write(proc.stdout or "")
    sys.stderr.write(proc.stderr or "")
    return proc.returncode


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
