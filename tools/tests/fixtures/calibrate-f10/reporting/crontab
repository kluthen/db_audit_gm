# f10's calibration fixture (v0.4 chunk 9; master spec 16.3): postgres's
# seed crontab on reporting, the agency's nightly sales-detail roll-up as
# bi_etl in capture W1 item 8's baseline form. 03:00 in UTC here (no render:
# a scenario's is in scenario time). The calibration moves the entry's time
# through gm-crontab, as a player may, and never runs its command by hand.
PGPASSFILE=/run/gm-cron/pgpass
0 3 * * * psql -X -w -h /run/postgresql -U bi_etl -d reporting -c 'CALL rpt.sales_detail_rollup()' >> /var/log/postgresql/cron/sales-detail-rollup.log 2>&1
