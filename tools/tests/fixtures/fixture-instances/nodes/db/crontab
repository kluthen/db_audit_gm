# Seed crontab of db for the fixture scenario fixture-instances
# (tools/tests/fixtures), installed once as postgres's crontab. The baseline
# entry's form (v0.4 capture W1 item 8): PGPASSFILE on a line of its own;
# psql -X -w over the local socket as the crontab role shop_etl, whose
# password load-data sets; output appended to the job's log.
PGPASSFILE=/run/gm-cron/pgpass
* * * * * psql -X -w -h /run/postgresql -U shop_etl -d shop -c "INSERT INTO crontab_runs DEFAULT VALUES" >> /var/log/postgresql/cron/crontab-mark.log 2>&1
