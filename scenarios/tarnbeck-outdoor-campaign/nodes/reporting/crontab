# Lumen Analytics' crontab on the reporting server (OS user postgres): the
# nightly sales-detail roll-up, the job's output appended to its log.
# PGPASSFILE holds the passwords of the roles a job may connect as.
PGPASSFILE=/run/gm-cron/pgpass
0 3 * * * psql -X -w -h /run/postgresql -U bi_etl -d reporting -c 'CALL rpt.sales_detail_rollup()' >> /var/log/postgresql/cron/sales-detail-rollup.log 2>&1
