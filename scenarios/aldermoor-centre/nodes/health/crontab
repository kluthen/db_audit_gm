# Seed crontab of the health node in aldermoor-centre (master spec 7.4, O226):
# the checks over health.yaml's four instances, the IT's disk alarm on the
# three primaries, and last night's base backups in cold storage, after the
# nightly jobs (records 03:30, lab 03:45, machines 04:00 UTC). Each line's
# results land on the page (/health/).
PATH=/usr/local/bin:/usr/bin:/bin
MAILTO=""
# the health page's checks on the four database servers (check_postgres over health.yaml)
*/5 * * * * health-run checks
# the IT's disk alarm on records' databases: warning at 2 GB, critical at 4 GB
*/5 * * * * health-run script disk-alarm 2048 4096 records
# the IT's disk alarm on lab's databases: warning at 2 GB, critical at 4 GB
*/5 * * * * health-run script disk-alarm 2048 4096 lab
# the IT's disk alarm on machines' databases: warning at 2 GB, critical at 4 GB
*/5 * * * * health-run script disk-alarm 2048 4096 machines
# is records' base backup of last night in Cold Storage? after its nightly backup
30 6 * * * health-run script backup-there http://cold-storage:8000 records
# is lab's base backup of last night in Cold Storage? after its nightly backup
30 6 * * * health-run script backup-there http://cold-storage:8000 lab
# is machines' base backup of last night in Cold Storage? after its nightly backup
30 6 * * * health-run script backup-there http://cold-storage:8000 machines
