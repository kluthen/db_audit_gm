*.db

# Local implementations inside scenario folders (master spec 5, 10.3)
local/
# ...but not a brick image's /usr/local (bricks/<brick>/rootfs/usr/local)
!bricks/*/rootfs/usr/local/

# Python bytecode (tools/)
__pycache__/

# The shop's real-aging reference, extracted from its archive outside git
# (v0.6 master spec 12.3, spec D519): a cache, never tracked
/tools/fake_aging/reference/extracted/

# The game assistant's default folder for the players' report and drafts
# (v0.7 master spec 6.8)
/play/

# The GM's session settings, generated by tools/play gm at each launch
# (v0.7 master spec 7.6), and its temporary copy while written
/.claude/game-master.settings.json
/.claude/game-master.settings.json.tmp
