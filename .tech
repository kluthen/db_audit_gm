# Technologies this project depends on. Kept by security-advisor (dev_team),
# read by cve-watch. Package dependencies come from the lockfiles; list here
# only what they don't cover.
#
# What db_audit_gm runs is ten Docker bricks (bricks/*, images
# 127.0.0.1:5000/dbagm/<brick>:<version>) on debian:13-slim, plus the GM's
# host tool (tools/gmctl, Debian's python3 and python3-yaml). Its one lockfile
# is the api brick's (from v0.5): bricks/api/requirements.txt, 15 hash-pinned
# wheels, read by osv-scanner. Versions below are those in the images built
# from this branch (dpkg-query inside each image, 2026-10-26; postgres 0.4.0,
# bastion 0.4.0 and scheduler 0.2.0 re-checked 2026-10-30; pgbadger in
# postgres 0.4.0 resolved 2026-10-31; pgbouncer 0.1.1 re-checked 2026-11-02,
# same 133 packages as 0.1.0; postgres 0.5.0, scheduler 0.3.0 and api 0.1.0
# resolved 2026-11-03 at v0.5 wave 1's gate G8, bastion 0.5.0 and grafana
# 0.3.0 being the bastion 0.4.0 and grafana 0.2.0 images retagged; pgwatch
# 0.1.0, health-check 0.1.0 and postgres 0.5.0 rebuilt with pgCluu resolved
# 2026-11-04 at v0.5 wave 2's gate G10, grafana 0.3.0 gaining a dashboard
# seed and no package; grafana 0.3.0 rebuilt on Grafana 13.3.0 the same day,
# owner ruling D396, its 129 Debian packages at the versions recorded
# below; bastion 0.5.0 rebuilt with curl at v0.5 wave 4's gate G11.2
# (91aad3f, 157 packages) and prometheus 0.2.0 and postgres-exporter 0.2.0
# read 2026-11-10; grafana 0.3.0 rebuilt on Grafana 13.3.1 (label kept,
# owner ruling D458) and prometheus 0.2.1 on Prometheus 3.16.0 at v0.5
# wave 5's gate G11.4, 2026-11-12, their Debian packages unchanged: 129 and
# 126, prometheus 0.2.1's dpkg-query list identical to 0.2.0's). v0.6 wave 1
# (merge 15a5e1a, gate G5, 2026-11-16): every brick took a new tag, bastion
# 0.6.0, grafana 0.4.0, scheduler 0.4.0, postgres 0.5.1, api 0.1.1,
# health-check 0.1.1, pgbouncer 0.1.2, pgwatch 0.1.1, postgres-exporter 0.2.1,
# prometheus 0.2.2; nine are the v0.5 images retagged (image IDs equal to
# bastion 0.5.0, grafana 0.3.0, postgres 0.5.0, api 0.1.0, health-check 0.1.0,
# pgbouncer 0.1.1, pgwatch 0.1.0, postgres-exporter 0.2.0, prometheus 0.2.1),
# scheduler 0.4.0 is rebuilt with its fill mode (standard library and the
# psycopg it already had, no new package) and its dpkg-query list is identical
# to 0.3.0's (142 packages). No Dockerfile changed a package or a pinned
# download, no lockfile or SBOM changed; dpkg-query read in all ten v0.6
# images 2026-11-16, every version below holds. v0.6 wave 2 (chunk 6, merge
# 153fc24, gate G7, 2026-11-17): bastion 0.6.0 rebuilt with jq and tmux
# (Debian, --no-install-recommends, unpinned), 163 packages: the 157 of 0.5.0,
# six new (jq, libjq1, libonig5, tmux, libevent-core-2.1-7t64, libjemalloc2;
# libutempter0 absent) and PGDG libpq5 and postgresql-client-18 moved from
# 18.6 to 18.7-1.pgdg13+2. v0.6 wave 2's gate G9.1 (2026-11-17, PostgreSQL's
# 2026-11-12 security release): postgres 0.5.1 (c2ebb6cceaed), pgbouncer
# 0.1.2 (387417b98d9e), scheduler 0.4.0 (c368bd08207f), api 0.1.1
# (4518e6873dde) and health-check 0.1.1 (d27fee8b444b) rebuilt --no-cache
# --pull, same tags (unreleased); dpkg-query read in each by the advisor the
# same day and diffed against the previous image: postgres libpq5,
# postgresql-18 and postgresql-client-18 18.6 -> 18.7-1.pgdg13+2;
# pgbouncer the same client pair, libcares2 1.34.5-1+deb13u1 ->
# 1.34.9-1~deb13u1, and PGDG postgresql-client, -client-common, -common and
# -common-dev 293.pgdg13+1 -> 295.pgdg13+1; scheduler and api libpq5 17.11 ->
# 17.12-0+deb13u1; health-check libpq5 and postgresql-client-17 the same;
# nothing else. The G9.1 follow-up (commit 1a123a6, spec D539, 2026-11-18)
# re-pinned postgres 0.5.1's two C extensions to PGDG's rebuilds against
# 18.7 and rebuilt it --no-cache --pull, same tag (unreleased):
# c2ebb6cceaed -> 52300dbef515, dpkg-query read by the advisor and diffed
# (153 packages): postgresql-18-cron 1.6.8-1.pgdg13+2 -> +3 and
# postgresql-18-pgaudit 18.0-3.pgdg13+1 -> +2, nothing else. A cached
# docker build of a brick keeps its old apt layer: security updates arrive
# only with --no-cache. The Go binaries downloaded
# as release tarballs
# (prometheus, promtool, grafana and its bundled Prometheus data source
# plugin, postgres_exporter, pgwatch) are described by one CycloneDX SBOM
# each, bricks/<brick>/sbom/<binary>.cdx.json, which osv-scanner reads on
# every sweep (the Go toolchain as Go/stdlib, every module go version -m
# reports, the main module where OSV can match its version). tools/go-sbom
# generate <brick> writes them from the exact archive the Dockerfile pins
# (SHA-256 checked; 2026-11-04 each binary's hash equal to the one in the
# built image); tools/tests/test_go_sbom.py fails while an SBOM records
# another version or checksum than its Dockerfile, so a bump must regenerate
# them. Debian package versions carry backported fixes, so an NVD match on
# one is settled by the Debian security tracker.
#
# A brick's tag names one Debian package list (owner ruling 2026-11-10): a
# rebuild that changes an image's content (a Debian package version, a pinned
# binary's release) takes the next patch version, with the scenario re-pins in
# the same wave; a rebuild keeps its tag only when its dpkg-query list is
# identical. The per-image versions recorded below rely on it.
schema = 1
updated = 2026-11-18

[stack]
languages = ["Python 3.13", "POSIX shell", "Perl 5.40 (postgres brick: vault-post with core HTTP::Tiny, pgBadger, pgCluu; health-check brick: check_postgres, health-run)"]
frameworks = ["FastAPI 0.162 (api brick)", "Uvicorn 0.54", "Pydantic 2.14", "psycopg 3.3 (api, pure Python over Debian libpq)"]
runtime = ["Docker Engine 29 (swarm mode)", "s6-overlay 3.2", "cron 3.0pl1 (Debian, postgres and health-check bricks)"]
base_image = ["debian:13-slim (Debian 13.7 trixie)"]
data = ["PostgreSQL 18 (PGDG, TLS on from postgres 0.5.0, now 0.5.1)", "pg_cron 1.6 (PGDG)", "pgaudit 18.0 (PGDG)", "PgBouncer 1.26 (PGDG)"]
monitoring = ["Prometheus 3.16", "postgres_exporter 0.20", "Grafana 13.3 (bundled Prometheus data source 13.2)", "pgwatch 6.1 (pgwatch brick, Prometheus sink)", "check_postgres 2.26 (Debian, health-check brick)", "pgBadger 13.3 (PGDG, postgres brick)", "pgCluu 5.0 (PGDG, postgres brick)"]
bricks = ["postgres 0.5.1", "bastion 0.6.0", "prometheus 0.2.2", "postgres-exporter 0.2.1", "grafana 0.4.0", "scheduler 0.4.0", "pgbouncer 0.1.2", "api 0.1.1", "pgwatch 0.1.1", "health-check 0.1.1"]
rendering = ["cmark-gfm 0.29 (Debian, bastion starter-pack page)"]
web = ["nginx 1.26 (Debian, bastion web front and health-check status page)"]
clients = ["curl 8.14 (Debian; the bastion players' HTTP client from bastion 0.5.0, now 0.6.0, and in seven other bricks)"]
tools = ["jq 1.7 (Debian; bastion 0.6.0, grafana 0.4.0, postgres-exporter 0.2.1)", "tmux 3.5 (Debian; bastion 0.6.0)"]
bastion_tools = ["psql 18 (PGDG)", "OpenSSH client 10.0", "curl 8.14", "jq 1.7", "tmux 3.5", "openssl 3.5", "less, nano, vim-tiny", "the web front: nginx 1.26 and cmark-gfm 0.29"]
lockfiles = [
    "bricks/api/requirements.txt",  # the api brick's 15 hash-pinned wheels (gate G6); the GM tool uses only Debian's python3-yaml
    # Go modules inside the release binaries, generated by tools/go-sbom (CycloneDX, read as SBOMs)
    "bricks/prometheus/sbom/prometheus.cdx.json",
    "bricks/prometheus/sbom/promtool.cdx.json",
    "bricks/postgres-exporter/sbom/postgres_exporter.cdx.json",
    "bricks/grafana/sbom/grafana.cdx.json",
    "bricks/grafana/sbom/gpx_grafana-prometheus-datasource_linux_amd64.cdx.json",
    "bricks/pgwatch/sbom/pgwatch.cdx.json",
]

# --- the game's host ----------------------------------------------------------

[[platform]]
name = "Docker Engine (armenelos, swarm manager)"
version = "29.9.3"
cpe = "cpe:2.3:a:docker:engine"
source = "host: docker version on armenelos, 2026-11-16 (client and server 29.9.3, Go 1.26.10, containerd v2.4.2, runc 1.5.2; 29.9.1 on 2026-10-26). NVD (cve-watch latest --version 29.9.3): 0, 2026-11-16"

[[platform]]
name = "Docker Engine (VPS vps-5718ad52, swarm worker from v0.3 wave 3)"
version = "29.9.2"
cpe = "cpe:2.3:a:docker:engine"
source = "host: ssh vps docker version, 2026-10-26 (client and server 29.9.2, Go 1.26.10, containerd v2.4.2, runc 1.5.2); upgraded by the owner from 28.5.1 the same day"

# --- the shared base of every brick -------------------------------------------

[[platform]]
name = "Debian (base image debian:13-slim)"
version = "13.7"
source = "bricks/*/Dockerfile FROM debian:13-slim (floating tag; 13.7 in the images built 2026-10-26). No cpe: debian:debian_linux matches distribution-wide CVEs, not this image's packages; the packages that matter are listed below"

[[platform]]
name = "s6-overlay"
version = "3.2.3.2"
source = "bricks/*/Dockerfile ARG S6_OVERLAY_VERSION, sha256-pinned release archive. No CPE exists on NVD (checked 2026-10-26); watch github.com/just-containers/s6-overlay"

[[platform]]
name = "OpenSSH server and client"
version = "10.0"
cpe = "cpe:2.3:a:openbsd:openssh"
source = "Debian openssh-server 1:10.0p1-7+deb13u4 in all ten v0.6 images (apt, unpinned; upstream 10.0p1; dpkg-query 2026-11-16, v0.6 gate G5), on Debian glibc 2.41 (libc6 2.41-12+deb13u4), never musl. sshd: PasswordAuthentication yes on bastion only (the players' login), no elsewhere; UsePAM no everywhere"

[[platform]]
name = "sudo"
version = "1.9.16p2"
cpe = "cpe:2.3:a:sudo_project:sudo"
source = "Debian sudo 1.9.16p2-3+deb13u2 in the nine v0.6 images other than bastion (apt, unpinned; dpkg-query 2026-11-16, v0.6 gate G5)"

[[platform]]
name = "OpenSSL"
version = "3.5.7"
cpe = "cpe:2.3:a:openssl:openssl"
source = "Debian libssl3t64 3.5.7-1~deb13u3 (trixie-security) in all ten v0.6 images, the openssl command in bastion 0.6.0, pgbouncer 0.1.2 and postgres 0.5.1 (apt, unpinned; dpkg-query 2026-11-16, v0.6 gate G5). Network-facing in postgres 0.5.1 (server TLS on, the 0.5.0 image); bricks/postgres/Dockerfile asserts the floor ARG LIBSSL_FLOOR=3.5.7-1~deb13u3 (gate G5) and removes ssl-cert's snakeoil pair; bricks/health-check/Dockerfile asserts the same floor (gate G9) for libpq's TLS client (check_postgres and the customer's scripts to PostgreSQL 18 over TLS). pgwatch 0.1.1's collector is a static Go binary on Go's crypto/tls, not OpenSSL; its libssl3t64 serves curl and ssh only. NVD matches 3.5.7 to OpenSSL's 2026-08-25 batch (fix 3.5.8) and 2026-09-29 batch (fix 3.5.9); Debian backported both, DSA-6465-1 (3.5.7-1~deb13u2) and DSA-6531-1 (3.5.7-1~deb13u3), no openssl issue open in trixie on the Debian tracker (2026-11-03): those NVD findings are false positives on these images. Re-checked 2026-11-09 and 2026-11-16 (v0.6): all ten images run 3.5.7-1~deb13u3; the tracker marks every NVD match on 3.5.7 at or above medium (19, CVE-2026-14456 included) fixed in trixie at deb13u2 or deb13u3 (accepted below, owner ruling 2026-11-10)"

[[platform]]
name = "curl / libcurl (Debian)"
version = "8.14.1"
cpe = "cpe:2.3:a:haxx:curl"
source = "Debian curl and libcurl4t64 8.14.1-2+deb13u7 (trixie-security's latest, uploaded 2026-10-14; apt, unpinned), the OpenSSL build (curl -V: libcurl/8.14.1 OpenSSL/3.5.7 with nghttp2, nghttp3, libssh2, librtmp, OpenLDAP, libpsl, libidn2, brotli, zstd). bastion 0.5.0: added with --no-install-recommends (gate G11.2, owner accepted 2026-11-10), the players' HTTP client for the partners' endpoints, run by the unprivileged player, no listener; image built 2026-11-10 from 91aad3f, dpkg-query the same day: 14 packages over bastion 0.4.0, curl, libcurl4t64 and libbrotli1 1.1.0-2+deb13u1, libffi8 3.4.8-2, libgnutls30t64 3.8.9-3+deb13u4, libidn2-0 2.3.8-2, libnghttp2-14 1.64.0-1.1+deb13u1, libnghttp3-9 1.8.0-1, libp11-kit0 0.25.5-3, libpsl5t64 0.21.2-1.1+b1, librtmp1 2.4+20151223.gitfa8646d.1-2+b5, libssh2-1t64 1.11.1-1+deb13u2, libtasn1-6 4.20.0-2+deb13u1, libunistring5 1.3-2 (libldap2 2.6.10+dfsg-1 and libsasl2-2 2.1.28+dfsg1-9 were already there, through libpq5). Also in api 0.1.0, grafana 0.3.0, health-check 0.1.0, pgwatch 0.1.0 and scheduler 0.3.0 (dpkg-query 2026-11-09), prometheus 0.2.0 and postgres-exporter 0.2.0 (dpkg-query 2026-11-10: curl already in their 0.1.0 images), all at deb13u7 with the same libraries as bastion. v0.6 (dpkg-query 2026-11-16, gate G5): curl and libcurl4t64 8.14.1-2+deb13u7 in the same eight, bastion 0.6.0, api 0.1.1, grafana 0.4.0, health-check 0.1.1, pgwatch 0.1.1, scheduler 0.4.0, prometheus 0.2.2 and postgres-exporter 0.2.1; not in pgbouncer or postgres. NVD matches 42 CVEs on 8.14.1 (2026-11-10): 19 fixed by Debian backports up to deb13u7, 1 not affected in Debian (CVE-2026-80231), 22 open in trixie (16 no-DSA minor, 6 unimportant), accepted below until 2027-02-01 or the next trixie curl security upload, whichever comes first. The Debian tracker lists 17 more curl issues open in trixie that NVD has not matched yet (urgency not yet assigned, 2026-11-10; CVE-2026-107928 needs a GnuTLS build, not this one): each surfaces as a new finding once NVD analyses it, triaged then. The pulled-in libraries on the Debian tracker (2026-11-10): brotli, libssh2, libidn2, libpsl, libffi, libtasn1-6, libunistring and nghttp3 nothing open in trixie; gnutls28 6 unimportant (certificate-checking nits; used here only by librtmp); openldap 5 unimportant (slapd, LMDB, NSS); nghttp2 CVE-2026-58055 (the nghttpx proxy, not the library); p11-kit CVE-2026-13757 and -18938 (no-DSA minor, its RPC server, never run; the second 32-bit only); rtmpdump CVE-2026-112060 and -112061 (undetermined: a malicious RTMP server against the client, reached only by a player running curl rtmp:// in their own session); cyrus-sasl2 CVE-2026-107161 (DIGEST-MD5 client plugin overflow, fix due in a trixie point release; that plugin's package libsasl2-modules is in none of the eight images, only libsasl2-modules-db). None gets a platform entry: NVD would add only backport false positives, and their fixes arrive with an unpinned rebuild; they fall under the same acceptance (G11.2). Watch: the Debian tracker's curl, rtmpdump and cyrus-sasl2, and curl.se/docs/vuln-8.14.1.html"

# --- per brick ------------------------------------------------------------------

[[platform]]
name = "PostgreSQL (server and client tools)"
version = "18.7"
cpe = "cpe:2.3:a:postgresql:postgresql"
source = "PGDG postgresql-18 / postgresql-client-18 / libpq5 18.7-1.pgdg13+2 (trixie-pgdg's current): postgres 0.5.1 (server, TLS on, standby and WAL archiving; image 52300dbef515 since the G9.1 follow-up's rebuild of 2026-11-18, c2ebb6cceaed at G9.1, same PostgreSQL packages) and pgbouncer 0.1.2 (client; 387417b98d9e), both rebuilt --no-cache at v0.6 wave 2's gate G9.1, dpkg-query 2026-11-17; bastion 0.6.0 (client, rebuilt at G7) the same. Dockerfile pins the major (ARG PG_MAJOR=18), the minor follows PGDG at build time, so a cached build keeps the old minor. 18.7 (2026-11-12) fixes PostgreSQL's 2026-11-12 batch (postgresql.org/support/security: 52 CVEs affecting 18, server and client, many CVSS 8.8); that page lists no advisory affecting 18.7 and no out-of-cycle release since (checked 2026-11-17). NVD has no CPE configuration for the batch yet (cve-watch latest --version 18.7: 0, 18.6: 0, 2026-11-17), so the sweep never raised it. CVE-2026-6460 (composite datums vs ALTER ... SET DATA TYPE, 8.8) needs C extensions rebuilt against 18.7 for full protection: postgres 0.5.1's only out-of-tree C extensions, pg_cron and pgaudit, are PGDG's rebuilds against 18.7 since the G9.1 follow-up (below; the contrib modules ship in postgresql-18 itself), so the image has the fix in full (advisor, 2026-11-18). Players are the superuser dba and the other roles are the game's own services, so the batch's unprivileged-user attacks had no attacker here; the fix is in anyway. Watch: postgresql.org/support/security"

[[platform]]
name = "PostgreSQL client library and psql 17 (libpq; scheduler, api and health-check)"
version = "17.12"
cpe = "cpe:2.3:a:postgresql:postgresql"
source = "Debian libpq5 17.12-0+deb13u1 (trixie-security, DSA-6625-1; apt, unpinned; the three images rebuilt --no-cache at v0.6 wave 2's gate G9.1, dpkg-query 2026-11-17): scheduler 0.4.0 (c368bd08207f), pulled by python3-psycopg; api 0.1.1 (4518e6873dde), installed directly under pure-Python psycopg 3.3.7 (psycopg.pq.__impl__ python, never psycopg[binary]; gate G6); health-check 0.1.1 (d27fee8b444b), libpq5 and postgresql-client-17 17.12-0+deb13u1 (with postgresql-client 17+278, postgresql-client-common 278) pulled by check-postgres 2.26.0-2, Debian's psql 17 run by check_postgres against PostgreSQL 18 over TLS (every chosen action tested on 18; gate G9, 2026-11-04). Clients only, no server. DSA-6625-1 fixes the 47 CVEs of the 2026-11-12 batch that touch 17 (Debian tracker; OSV Debian:13 postgresql-17 17.11-0+deb13u1: 47, 17.12-0+deb13u1: 0, 2026-11-17); NVD matches neither version yet (cve-watch latest --version 17.12: 0). The api and scheduler stack tests rebuilt their image with a cached docker build at G9.1 and brought back 17.11 (being fixed): read dpkg-query again after any rebuild of those two"

[[platform]]
name = "PgBouncer"
version = "1.26.1"
cpe = "cpe:2.3:a:pgbouncer:pgbouncer"
source = "bricks/pgbouncer/Dockerfile ARG PGBOUNCER_PACKAGE=1.26.1-1.pgdg13+1 (PGDG, owner ruling D177), unchanged in the G9.1 rebuild (dpkg-query 2026-11-17). 1.26.1 (2026-10-14) is upstream's latest and fixes CVE-2026-107348/-107349/-107350; NVD (cve-watch latest --version 1.26.1): 0, 2026-11-17. Watch: pgbouncer.org/changelog.html"

[[platform]]
name = "c-ares (pgbouncer brick)"
version = "1.34.9"
cpe = "cpe:2.3:a:c-ares:c-ares"
source = "Debian libcares2 1.34.9-1~deb13u1 (trixie-security, DSA-6626-1; apt, unpinned) in pgbouncer 0.1.2, rebuilt --no-cache at v0.6 wave 2's gate G9.1 (image 387417b98d9e, dpkg-query 2026-11-17; 1.34.5-1+deb13u1 before), PgBouncer's resolver for its [databases] hosts through Docker's embedded DNS on the overlay. 1.34.9 (2026-10-20) is upstream's latest; it and DSA-6626-1 close everything open since v0.4: CVE-2025-62408, CVE-2026-33630, -69184, -69186 (DSA-6626-1) and the 11 GHSA advisories of 1.34.9 (tracker TEMP entries, trixie (security) fixed at 1.34.9-1~deb13u1). Checked 2026-11-17: NVD (cve-watch latest --version 1.34.9) 0; OSV Debian:13 c-ares 1.34.9-1~deb13u1 0 (1.34.5-1+deb13u1: 4); the Debian tracker's c-ares lists nothing open in trixie (security). Watch: the Debian tracker's c-ares and github.com/c-ares/c-ares security advisories"

[[platform]]
name = "nginx (bastion web front, health-check status page)"
version = "1.26.3"
cpe = "cpe:2.3:a:f5:nginx_open_source"
source = "Debian nginx 1.26.3-3+deb13u10 in bastion 0.6.0 (the 0.5.0 image, rebuilt with curl 2026-11-10, nginx unchanged) and nginx and nginx-common 1.26.3-3+deb13u10 in health-check 0.1.1 (apt, unpinned; gate G9, re-checked 2026-11-04 and 2026-11-16). health-check serves static files only on :8080 under /health/, reached only through the bastion's web_routes: GET and HEAD, autoindex and server_tokens off, no libnginx-mod-* package and no module loaded, no proxy, fastcgi, uwsgi, scgi, grpc, dav, charset, rewrite, mail or stream directive, no HTTP/2 or 3 (asserted by the Dockerfile on nginx -T), so NVD's module CVEs on 1.26.3 (proxy_v2, grpc, charset, rewrite) have no code path there. The Debian tracker lists only 2 unimportant trixie issues (CVE-2009-4487, CVE-2013-0337; 2026-11-04)"

[[platform]]
name = "pg_cron (PostgreSQL extension, postgres brick)"
version = "1.6.8"
source = "bricks/postgres/Dockerfile ARG PG_CRON_PACKAGE=1.6.8-1.pgdg13+3 (PGDG postgresql-18-cron, pinned and asserted by dpkg-query at build; v0.4 gate G5; re-pinned from +2 by the G9.1 follow-up, commit 1a123a6, spec D539) in postgres 0.5.1 (image 52300dbef515, dpkg-query 2026-11-18; apt-cache policy in the image: +3 is PGDG's candidate). No CPE exists on NVD (checked 2026-10-30), no OSV ecosystem. Upstream 1.6.8 (2026-09-08) is the latest release, no repository advisory (2026-11-18). +3 is the same source rebuilt against PostgreSQL 18.7 (changelog: no source changes): it Depends postgresql-18 (>> 18.7), satisfied by 18.7-1.pgdg13+2, where +2 Depended on postgresql-18 unversioned, and its pg_cron.so differs from +2's (sha256 3702704036b1… vs a52713ee96ef…). That closes the extension half of CVE-2026-6460 (18.7's notes: full protection needs C extensions rebuilt), open on +2 from G9.1 to the follow-up and never reachable as an attack here (only the superuser dba and the game's own service roles connect; pg_cron reads its own cron.job table) (advisor, 2026-11-18). A later PGDG rebuild against a newer minor is a re-pin, not an apt upgrade: the build asserts the exact version. Watch: github.com/citusdata/pg_cron and the Debian tracker's pg-cron"

[[platform]]
name = "cron (Debian, postgres and health-check bricks)"
version = "3.0pl1-197"
source = "Debian cron and cron-daemon-common 3.0pl1-197 in postgres 0.5.1 (apt, unpinned; gate G5) and health-check 0.1.1 (gate G9: postgres's spool crontab only, /etc/crontab and the cron.d and run-parts entries removed; re-checked 2026-11-04). Debian's own Vixie cron fork, versioned by its Debian revision: no CPE fits (none for vixie cron on NVD, checked 2026-10-30; NVD's 3.0 hits such as CVE-2019-9706 are fixed in 3.0pl1-133). The Debian tracker's source package cron is the watch (no open issue in trixie as of 2026-10-30; OSV Debian:13 cron 3.0pl1-197 clean 2026-11-04)"

[[platform]]
name = "pgBadger (PostgreSQL log analyser, postgres brick)"
version = "13.3"
source = "PGDG pgbadger 13.3-1.pgdg13+1 in postgres 0.5.1 (bricks/postgres/Dockerfile, apt, unpinned, installed with postgresql-${PG_MAJOR}; build asserts pgbadger --version), in the image since 0.3.0 (13.2 until 0.4.0); Perl script on Debian perl 5.40.1-6+deb13u1, which also runs vault-post (core HTTP::Tiny 0.088) from 0.5.0. Players run it by hand on the file log, writing HTML reports in their home (brick.yaml report_tools); no daemon, no listener. No CPE exists on NVD and NVD has no CVE mentioning pgbadger (checked 2026-10-31); no OSV record (Debian:13 query clean), no GitHub advisory and no SECURITY.md on github.com/darold/pgbadger, no issue on the Debian tracker's source package pgbadger. 13.3 (2026-11-03) is upstream's latest release, a maintenance release with no security note (it sanitises database names used as paths with --explode; checked 2026-11-03). Watch: darold/pgbadger releases and the Debian tracker"

[[platform]]
name = "pgCluu (PostgreSQL performance reports, postgres brick)"
version = "5.0"
source = "bricks/postgres/Dockerfile ARG PG_CLUU_PACKAGE=5.0-1.pgdg13+1 (PGDG pgcluu, pinned and asserted by dpkg-query at build; gate G9) in postgres 0.5.1 (in the image since 0.5.0's 2026-11-04 rebuild), not Debian's 4.0-1 (no PostgreSQL 17/18 collection). Perl scripts run by hand by the player (pgcluu_collectd --disable-sar --disable-pidstat, then pgcluu -o in their home), never a daemon, no sudo rule; its report CGI /usr/lib/cgi-bin/pgcluu.cgi and /etc/apache2/conf-available/pgcluu.conf deleted and asserted gone, no web server, no sysstat. Brings Debian libjs-jquery 3.6.1+dfsg+~3.5.14-1 and libjs-underscore 1.13.4~dfsg+~1.11.4-3 for the HTML report: underscore 1.13.4 is affected by CVE-2026-27601 (GHSA-qpx9-hpmf-5gmw, unbounded recursion in _.flatten and _.isEqual, fix 1.13.8; open in trixie), a denial of service in the browser of whoever opens a report built from their own collection: not reachable as an attack. No CPE exists on NVD (checked 2026-11-04); OSV Debian:13 pgcluu clean, no GitHub advisory on github.com/darold/pgcluu. Watch: darold/pgcluu releases, the Debian tracker's pgcluu and underscore"

[[platform]]
name = "check_postgres (health-check brick)"
version = "2.26.0"
source = "bricks/health-check/Dockerfile ARG CHECK_POSTGRES_PACKAGE=2.26.0-2 (Debian check-postgres, no recommends, pinned and asserted by dpkg-query and --version at build; gate G9) in health-check 0.1.1. Perl script on Debian perl 5.40.1-6+deb13u1 over Debian psql/libpq 17.12 (entry above), run as postgres from its spool crontab every five minutes (--timeout=15, each run bounded at 30 s) against the scenario's PostgreSQL 18 nodes over TLS, the password in PGPASSFILE, never --dbpass. No CPE exists on NVD (checked 2026-11-04); OSV Debian:13 check-postgres clean, no issue on the Debian tracker. Upstream (github.com/bucardo/check_postgres) dormant since its 2.26.0 release in 2023: a future fix may come only as a Debian patch. Watch: the Debian tracker's check-postgres and perl"

[[platform]]
name = "pgaudit (PostgreSQL extension, postgres brick)"
version = "18.0"
source = "bricks/postgres/Dockerfile ARG PG_AUDIT_PACKAGE=18.0-3.pgdg13+2 (PGDG postgresql-18-pgaudit, pinned and asserted by dpkg-query and pgaudit.so at build; v0.5 gate G5; re-pinned from +1 by the G9.1 follow-up, commit 1a123a6, spec D539) in postgres 0.5.1, from v0.5 (image 52300dbef515, dpkg-query 2026-11-18; apt-cache policy in the image: +2 is PGDG's candidate). Writes DDL, WRITE and ROLE lines to the file log the players read; 18.0 redacts passwords in role statements itself (password <REDACTED>), PostgreSQL's own statement logging does not, so the password sessions run with pgaudit.log and statement logging off. No CPE exists on NVD (checked 2026-11-03), no OSV ecosystem (CVE-2025-23413 is F5's, not pgaudit's), no repository advisory (2026-11-18). +2 is the same source rebuilt against PostgreSQL 18.7 (no source changes): it Depends postgresql-18 (>> 18.7), satisfied by 18.7-1.pgdg13+2, where +1 Depended on postgresql-18 unversioned, and its pgaudit.so differs from +1's (sha256 548e3fa91b4b… vs 58a5f8f6b9f8…). That closes the extension half of CVE-2026-6460 for pgaudit, as for pg_cron above (open on +1 from G9.1 to the follow-up, never reachable as an attack here) (advisor, 2026-11-18). Upstream released pgAudit 18.1 on 2026-11-17 (not in PGDG yet; 2026-11-18 the image's candidate is still 18.0-3.pgdg13+2): bug fixes with no advisory, one a use-after-free reading an object's name after an event trigger, others changing which lines are logged (a statement's own permission check only, no non-enforcing checks, COPY rows with pgaudit.log_rows), so taking it changes what the players read: a later game-content decision (owner's ruling), not a security fix. Watch: github.com/pgaudit/pgaudit security advisories and releases, PGDG pgaudit-18"

[[platform]]
name = "cmark-gfm (bastion starter-pack page)"
version = "0.29.0.gfm.13"
cpe = "cpe:2.3:a:github:cmark-gfm"
source = "Debian cmark-gfm, libcmark-gfm0.29.0.gfm.13 and libcmark-gfm-extensions0.29.0.gfm.13 0.29.0.gfm.13-4 in bastion 0.6.0 (apt, unpinned; gate G13), run at start-up as cmark-gfm -e table in safe mode (never --unsafe) on the GM's starter-pack files. Watch: upstream silent since 2023 (last release 0.29.0.gfm.13, July 2023); github/cmark-gfm took two commits since (2025-12 a cmake bump, 2026-09 PR #394 an undefined-behaviour fix in the autolink extension, no advisory, not enabled here) but no release, so a future fix may come only as a Debian patch"

[[platform]]
name = "jq (Debian; bastion, grafana, postgres-exporter)"
version = "1.7.1"
cpe = "cpe:2.3:a:jqlang:jq"
source = "Debian jq and libjq1 1.7.1-6+deb13u4 (trixie-security's latest) with libonig5 6.9.9-1+b1 (apt, unpinned): bastion 0.6.0 (bricks/bastion/Dockerfile, --no-install-recommends, chunk 6 at 153fc24, gate G6 cleared 2026-11-17; master spec 7.7: the players read Prometheus' API and the partners' status file with it, run as the unprivileged player on JSON from the game's own services), grafana 0.4.0 and postgres-exporter 0.2.1 (in their Dockerfiles before v0.6, never recorded until G7; the same versions); dpkg-query in all three images 2026-11-17 (G7). jq --version reports jq-1.7. NVD matches 17 CVEs on 1.7.1 (2026-11-17), every one fixed in trixie at or below deb13u4 on the Debian tracker (1.7.1-6 to 1.7.1-6+deb13u3): backport false positives, accepted below (owner, 2026-11-17). The tracker also lists CVE-2026-39956 and CVE-2026-40164, fixed in deb13u2, that NVD has not matched yet; they would fall under the same reasoning when it does. Open in trixie: only CVE-2025-9403 (DEBIAN-CVE-2025-9403 on OSV, Debian unimportant: the test suite, jq --run-tests, never run here). Oniguruma (libonig5) clean on OSV Debian:13 and the tracker. Watch: the Debian tracker's jq and libonig"

[[platform]]
name = "tmux (Debian; bastion)"
version = "3.5a"
cpe = "cpe:2.3:a:tmux_project:tmux"
source = "Debian tmux 3.5a-3 with libevent-core-2.1-7t64 2.1.13-stable-1~deb13u1 and libjemalloc2 5.3.0-3 in bastion 0.6.0 (bricks/bastion/Dockerfile, --no-install-recommends, unpinned; libutempter0, a Recommends, absent, so no utmp entries; chunk 6 at 153fc24, gate G6 cleared 2026-11-17; dpkg-query 2026-11-17, G7). Run by the player in their own SSH session (master spec 7.7), no setuid, no listener beyond its per-user socket under /tmp. NVD (cve-watch latest --version 3.5a): 0, 2026-11-17; CVE-2026-11623 is 3.6a's (Debian tracker: trixie not affected, unimportant). OSV Debian:13 tmux, libevent and jemalloc clean, nothing open in trixie on the tracker (2026-11-17). Watch: the Debian tracker's tmux and libevent"

[[platform]]
name = "Prometheus"
version = "3.16.0"
cpe = "cpe:2.3:a:prometheus:prometheus"
source = "bricks/prometheus/Dockerfile ARG PROMETHEUS_VERSION=3.16.0, sha256-pinned release tarball (68727009472a2c02e1ff7f062fd5b3e637285bffc8fc2d340c76fb449d6e0f34) in prometheus 0.2.2 (v0.6; the 0.2.1 image of v0.5 wave 5, spec D445/D446/D448, gate G11.4; 3.13.5 on the 3.13 LTS line until 0.2.0: from 0.2.1 the brick follows minor releases, D446). From v0.5 a scenario's scrape configuration may add a pgwatch job (<node>:9188, the overlay only). Built image 2026-11-12: prometheus and promtool --version 3.16.0 (revision e2e28ade), binary SHA-256 fe1fc9a01dbe... and a3c953f444da... equal to the SBOMs'. NVD (cve-watch latest --version 3.16.0: 0) and OSV Go module github.com/prometheus/prometheus v0.316.0 (0) clean, 2026-11-12. Embedded modules: bricks/prometheus/sbom/prometheus.cdx.json (242 components) and promtool.cdx.json (199), go1.27.3, the main module as its Go tag v0.316.0 (the binary's own build info would match every advisory). Fixed by 3.16.0: GHSA-2v4p-qf9q-27wj (grpc 1.84.0) and GO-2026-6865 (klauspost/compress 1.20.3). Left, none reachable (go tool nm on the built image's unstripped binaries, 2026-11-12): GO-2026-6860/6866 (x/net 0.61.0, no x/net/html symbol linked), GO-2026-5932 (x/crypto/openpgp, no symbol) and GO-2022-0635/0646 (aws-sdk-go S3 crypto, no s3crypto symbol, no fix exists); GO-2026-6859 (stdlib < 1.27.4, net/http MaxBytesReader race) is open in SECURITY_TODO.md, untriaged"

[[platform]]
name = "postgres_exporter"
version = "0.20.1"
source = "bricks/postgres-exporter/Dockerfile ARG PG_EXPORTER_VERSION, sha256-pinned release tarball. No CPE exists on NVD (checked 2026-10-26); OSV Go module github.com/prometheus-community/postgres_exporter has no advisory. Embedded modules: bricks/postgres-exporter/sbom/postgres_exporter.cdx.json, built with go1.26.4 (2026-07-08): 2026-11-04, 38 advisories on stdlib, x/net, x/crypto and x/text (fixes up to Go 1.27.3, x/net 0.62.0, x/crypto 0.56.0, x/text 0.41.0), none reachable in this brick: plain HTTP/1 on 9187 (no TLS, so no HTTP/2), handlers /metrics and / only (no multipart form, no CONNECT, no file serving, no unencrypted HTTP/2), its lib/pq client on sslmode=disable (TLS client advisories moot), Linux (GO-2026-6604 is Windows-only). 0.20.1 is upstream's latest release: no fixed build exists yet. 2026-11-09: govulncheck -mode=binary: 17 stdlib advisories at symbol level, none reachable as run (HTTP/1 only, no TLS server, no multipart, ECH or CONNECT); 0.20.1 still upstream's latest"

[[platform]]
name = "pgwatch (pgwatch brick)"
version = "6.1.0"
source = "bricks/pgwatch/Dockerfile ARG PGWATCH_VERSION=6.1.0, the release tarball pgwatch_Linux_x86_64.tar.gz, ADD --checksum=sha256:8c9bb13978e6e769b2c82f304479c2840bbcb44e9a6ba8209507cdfc24a117da (gate G9; not the .deb). Only the binary is installed, /usr/local/bin/pgwatch (commit 742aaf9, go1.26.9, static, no symbol table), with its built-in metric definitions; the build asserts the banner Version: 6.1.0 (pgwatch exits 1 with no sources) and that the basic preset needs no init SQL. Run as pgwatch 990 with --web-disable=all (nothing on :8080), a Prometheus sink on :9188 (the overlay only), the basic preset, the password in PGPASSFILE; never --create-helpers or --try-create-listed-exts-if-missing. No CPE exists on NVD (checked 2026-11-04); OSV Go module github.com/cybertec-postgresql/pgwatch/v6 6.1.0 and pgx/v5 5.11.0: 0 advisories. Embedded modules (osv-scanner --x-plugins=go/binary on the extracted binary, 45 packages, 2026-11-04): GO-2026-6809 (stdlib crypto/x509 distrust list, fix go1.26.10; the game's per-game CA has no public intermediate) and GO-2026-6860/GO-2026-6866 (golang.org/x/net/html 0.61.0, fix 0.62.0; package not linked): none reachable. The daily sweep reads its modules from bricks/pgwatch/sbom/pgwatch.cdx.json (45 components, 2026-11-04: the same three findings). Watch: github.com/cybertec-postgresql/pgwatch releases and security advisories"

[[platform]]
name = "Grafana"
version = "13.3.1"
cpe = "cpe:2.3:a:grafana:grafana"
source = "bricks/grafana/Dockerfile ARG GRAFANA_VERSION=13.3.1, GRAFANA_BUILD=42849527790, sha256-pinned release tarball (6acf8939dd2f73332cbcafc27a33973fb1115b8867e7ffa3223c6e2ecbed8531; v0.5 wave 5, spec D445/D446/D448, gate G11.3; was 13.3.0, owner ruling D396, and 13.2.4 before; the brick label stayed 0.3.0, owner ruling D458; v0.6 tags that image grafana 0.4.0). grafana 0.3.0 adds an optional pgwatch dashboard seed (JSON over the Prometheus series, no plugin). Built image 2026-11-12: grafana --version 13.3.1, binary SHA-256 f62d1816778c... and the bundled plugin's f1458b7bacfe... equal to the SBOMs'. The players log in as Grafana's administrator (the tools password). Fixed by 13.3.1 (its release notes; NVD published them 2026-11-11 with no CPE configuration yet, so cve-watch latest does not list them): CVE-2026-102589 (image-renderer key accepted across instances sharing renderer_token; no renderer here), CVE-2026-107509 (a Viewer crashes Grafana with an SQL Expression cast; the players are its administrators already), CVE-2026-110992, CVE-2026-111024, CVE-2026-13721 and CVE-2026-14242 (Git Sync provisioning path traversal and folder-permission bypasses; no Git Sync repository): none reachable as an attack here. Not in 13.3.1's notes: CVE-2026-110289 (GHSA-97fx-j86f-w2rp, Git Sync connection SSRF by an Org Admin, published 2026-11-11 with no affected or fixed range anywhere; no Git Sync connection here and the Org Admin is the players' own account): watch for its range. The grafana.com 2026-10-27 batch (CVE-2026-100105, -88858, -88967; CVE-2026-103506 behind the kubernetesSsoSettingsApi toggle, not set) fixed since 13.3.0. NVD (cve-watch latest --version 13.3.1: 0) and OSV clean 2026-11-12. Embedded modules: bricks/grafana/sbom/grafana.cdx.json (520 components, go1.27.3; main module left out: built as (devel), and OSV's Go records for github.com/grafana/grafana have no fixed version, so NVD above is its check; x/net 0.62.0, GO-2026-6860/6866 gone) and gpx_grafana-prometheus-datasource_linux_amd64.cdx.json (the kept bundled Prometheus data source plugin, plugin.json 13.2.5, its backend go1.27.3, stripped, 104 components; a child process on loopback gRPC with go-plugin's mTLS, an HTTP/1 client to Prometheus; brotli 1.2.7, so GO-2026-6888 is fixed, which was reachable through a data source a player points at their own server). Left, none reachable (2026-11-12): in grafana, GO-2026-5932 (x/crypto/openpgp) and GO-2022-0635/0646 (aws-sdk-go S3 crypto, no fix exists), modules only, no openpgp or s3crypto symbol (go tool nm); in the plugin, GO-2026-6860/6866 (x/net 0.61.0), no x/net/html function in its pclntab; in both, GO-2026-6859 (stdlib < 1.27.4), open in SECURITY_TODO.md, untriaged. The grafana.com catalogue's plugin 13.2.6 exists, not pinned (no security reason, G11.3)"

[[platform]]
name = "Python"
version = "3.13.5"
cpe = "cpe:2.3:a:python:python"
source = "Debian python3.13 3.13.5-2+deb13u5 (apt, unpinned; dpkg-query 2026-11-16): scheduler 0.4.0 (with python3-psycopg 3.2.6-1, python3-yaml 6.0.2; its fill mode adds no import beyond the standard library and psycopg), api 0.1.1 (with python3-yaml 6.0.2 and libyaml-0-2 0.2.5-2, safe loading only, gate G11.1; its PyPI wheels in bricks/api/requirements.txt, no pip in the image) and the GM host's python3 running tools/gmctl (armenelos upgraded from 3.13.5-2+deb13u4 to deb13u5 on 2026-11-10 after its stale trixie main Packages list was removed; apt-cache policy python3.13: installed 3.13.5-2+deb13u5, candidate the same; dpkg-query on the host 2026-11-16: python3.13 3.13.5-2+deb13u5, python3-yaml 6.0.2-1+b2; tools/gm/fill.py imports only the standard library, PyYAML and tools/gm itself)"

