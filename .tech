# Technologies this project depends on. Kept by security-advisor (dev_team),
# read by cve-watch. Package dependencies come from the lockfiles; list here
# only what they don't cover.
#
# What db_audit_gm runs is ten Docker bricks (bricks/*, images
# 127.0.0.1:5000/dbagm/<brick>:<version>) on debian:13-slim, plus the GM's
# host tool (tools/gmctl, Debian's python3 and python3-yaml). Its one lockfile
# is the api brick's (from v0.5): bricks/api/requirements.txt, 15 hash-pinned
# wheels, read by osv-scanner. Versions below are those in the images built
# from this branch (dpkg-query inside each image, 2026-10-26; postgres 0.4.0,
# bastion 0.4.0 and scheduler 0.2.0 re-checked 2026-10-30; pgbadger in
# postgres 0.4.0 resolved 2026-10-31; pgbouncer 0.1.1 re-checked 2026-11-02,
# same 133 packages as 0.1.0; postgres 0.5.0, scheduler 0.3.0 and api 0.1.0
# resolved 2026-11-03 at v0.5 wave 1's gate G8, bastion 0.5.0 and grafana
# 0.3.0 being the bastion 0.4.0 and grafana 0.2.0 images retagged; pgwatch
# 0.1.0, health-check 0.1.0 and postgres 0.5.0 rebuilt with pgCluu resolved
# 2026-11-04 at v0.5 wave 2's gate G10, grafana 0.3.0 gaining a dashboard
# seed and no package). The Go binaries downloaded as release tarballs
# (prometheus, promtool, grafana and its bundled Prometheus data source
# plugin, postgres_exporter, pgwatch) are described by one CycloneDX SBOM
# each, bricks/<brick>/sbom/<binary>.cdx.json, which osv-scanner reads on
# every sweep (the Go toolchain as Go/stdlib, every module go version -m
# reports, the main module where OSV can match its version). tools/go-sbom
# generate <brick> writes them from the exact archive the Dockerfile pins
# (SHA-256 checked; 2026-11-04 each binary's hash equal to the one in the
# built image); tools/tests/test_go_sbom.py fails while an SBOM records
# another version or checksum than its Dockerfile, so a bump must regenerate
# them. Debian package versions carry backported fixes, so an NVD match on
# one is settled by the Debian security tracker.
schema = 1
updated = 2026-11-04

[stack]
languages = ["Python 3.13", "POSIX shell", "Perl 5.40 (postgres brick: vault-post with core HTTP::Tiny, pgBadger, pgCluu; health-check brick: check_postgres, health-run)"]
frameworks = ["FastAPI 0.162 (api brick)", "Uvicorn 0.54", "Pydantic 2.14", "psycopg 3.3 (api, pure Python over Debian libpq)"]
runtime = ["Docker Engine 29 (swarm mode)", "s6-overlay 3.2", "cron 3.0pl1 (Debian, postgres and health-check bricks)"]
base_image = ["debian:13-slim (Debian 13.7 trixie)"]
data = ["PostgreSQL 18 (PGDG, TLS on from postgres 0.5.0)", "pg_cron 1.6 (PGDG)", "pgaudit 18.0 (PGDG)", "PgBouncer 1.26 (PGDG)"]
monitoring = ["Prometheus 3.13 (LTS)", "postgres_exporter 0.20", "Grafana 13.2", "pgwatch 6.1 (pgwatch brick, Prometheus sink)", "check_postgres 2.26 (Debian, health-check brick)", "pgBadger 13.3 (PGDG, postgres brick)", "pgCluu 5.0 (PGDG, postgres brick)"]
bricks = ["postgres 0.5.0", "bastion 0.5.0", "prometheus 0.2.0", "postgres-exporter 0.2.0", "grafana 0.3.0", "scheduler 0.3.0", "pgbouncer 0.1.1", "api 0.1.0", "pgwatch 0.1.0", "health-check 0.1.0"]
rendering = ["cmark-gfm 0.29 (Debian, bastion starter-pack page)"]
web = ["nginx 1.26 (Debian, bastion web front and health-check status page)"]
lockfiles = [
    "bricks/api/requirements.txt",  # the api brick's 15 hash-pinned wheels (gate G6); the GM tool uses only Debian's python3-yaml
    # Go modules inside the release binaries, generated by tools/go-sbom (CycloneDX, read as SBOMs)
    "bricks/prometheus/sbom/prometheus.cdx.json",
    "bricks/prometheus/sbom/promtool.cdx.json",
    "bricks/postgres-exporter/sbom/postgres_exporter.cdx.json",
    "bricks/grafana/sbom/grafana.cdx.json",
    "bricks/grafana/sbom/gpx_grafana-prometheus-datasource_linux_amd64.cdx.json",
    "bricks/pgwatch/sbom/pgwatch.cdx.json",
]

# --- the game's host ----------------------------------------------------------

[[platform]]
name = "Docker Engine (armenelos, swarm manager)"
version = "29.9.1"
cpe = "cpe:2.3:a:docker:engine"
source = "host: docker version on armenelos, 2026-10-26 (Go 1.26.9, containerd v2.4.2, runc 1.5.2)"

[[platform]]
name = "Docker Engine (VPS vps-5718ad52, swarm worker from v0.3 wave 3)"
version = "29.9.2"
cpe = "cpe:2.3:a:docker:engine"
source = "host: ssh vps docker version, 2026-10-26 (client and server 29.9.2, Go 1.26.10, containerd v2.4.2, runc 1.5.2); upgraded by the owner from 28.5.1 the same day"

# --- the shared base of every brick -------------------------------------------

[[platform]]
name = "Debian (base image debian:13-slim)"
version = "13.7"
source = "bricks/*/Dockerfile FROM debian:13-slim (floating tag; 13.7 in the images built 2026-10-26). No cpe: debian:debian_linux matches distribution-wide CVEs, not this image's packages; the packages that matter are listed below"

[[platform]]
name = "s6-overlay"
version = "3.2.3.2"
source = "bricks/*/Dockerfile ARG S6_OVERLAY_VERSION, sha256-pinned release archive. No CPE exists on NVD (checked 2026-10-26); watch github.com/just-containers/s6-overlay"

[[platform]]
name = "OpenSSH server and client"
version = "10.0"
cpe = "cpe:2.3:a:openbsd:openssh"
source = "Debian openssh-server 1:10.0p1-7+deb13u4, every brick, api 0.1.0, pgwatch 0.1.0 and health-check 0.1.0 included (apt, unpinned; upstream 10.0p1; re-checked 2026-11-04)"

[[platform]]
name = "sudo"
version = "1.9.16p2"
cpe = "cpe:2.3:a:sudo_project:sudo"
source = "Debian sudo 1.9.16p2-3+deb13u2, every brick but bastion, api 0.1.0, pgwatch 0.1.0 and health-check 0.1.0 included (apt, unpinned; re-checked 2026-11-04)"

[[platform]]
name = "OpenSSL"
version = "3.5.7"
cpe = "cpe:2.3:a:openssl:openssl"
source = "Debian libssl3t64 and openssl 3.5.7-1~deb13u3 (trixie-security) in every brick (apt, unpinned; checked 2026-11-03, pgwatch 0.1.0, health-check 0.1.0 and the rebuilt postgres 0.5.0 re-checked 2026-11-04). Network-facing in postgres 0.5.0 (server TLS on); bricks/postgres/Dockerfile asserts the floor ARG LIBSSL_FLOOR=3.5.7-1~deb13u3 (gate G5) and removes ssl-cert's snakeoil pair; bricks/health-check/Dockerfile asserts the same floor (gate G9) for libpq's TLS client (check_postgres and the customer's scripts to PostgreSQL 18 over TLS). pgwatch 0.1.0's collector is a static Go binary on Go's crypto/tls, not OpenSSL; its libssl3t64 serves curl and ssh only. NVD matches 3.5.7 to OpenSSL's 2026-08-25 batch (fix 3.5.8) and 2026-09-29 batch (fix 3.5.9); Debian backported both, DSA-6465-1 (3.5.7-1~deb13u2) and DSA-6531-1 (3.5.7-1~deb13u3), no openssl issue open in trixie on the Debian tracker (2026-11-03): those NVD findings are false positives on these images"

# --- per brick ------------------------------------------------------------------

[[platform]]
name = "PostgreSQL (server and client tools)"
version = "18.6"
cpe = "cpe:2.3:a:postgresql:postgresql"
source = "PGDG postgresql-18 / postgresql-client-18 / libpq5 18.6-1.pgdg13+2: postgres 0.5.0 (server, TLS on, standby and WAL archiving), bastion 0.5.0 and pgbouncer 0.1.1 (client); Dockerfile pins the major (ARG PG_MAJOR=18), the minor follows PGDG at build time"

[[platform]]
name = "PostgreSQL client library and psql 17 (libpq; scheduler, api and health-check)"
version = "17.11"
cpe = "cpe:2.3:a:postgresql:postgresql"
source = "Debian libpq5 17.11-0+deb13u1 (apt, unpinned): scheduler 0.3.0, pulled by python3-psycopg; api 0.1.0, installed directly under pure-Python psycopg 3.3.7 (psycopg.pq.__impl__ python, libpq 170011, never psycopg[binary]; gate G6); health-check 0.1.0, libpq5 and postgresql-client-17 17.11-0+deb13u1 (with postgresql-client 17+278, postgresql-client-common 278) pulled by check-postgres 2.26.0-2, Debian's psql 17 run by check_postgres against PostgreSQL 18.6 over TLS (every chosen action tested on 18; gate G9, 2026-11-04). Clients only, no server"

[[platform]]
name = "PgBouncer"
version = "1.26.1"
cpe = "cpe:2.3:a:pgbouncer:pgbouncer"
source = "bricks/pgbouncer/Dockerfile ARG PGBOUNCER_PACKAGE=1.26.1-1.pgdg13+1 (PGDG, owner ruling D177)"

[[platform]]
name = "nginx (bastion web front, health-check status page)"
version = "1.26.3"
cpe = "cpe:2.3:a:f5:nginx_open_source"
source = "Debian nginx 1.26.3-3+deb13u10 in bastion 0.5.0 (the 0.4.0 image retagged) and nginx and nginx-common 1.26.3-3+deb13u10 in health-check 0.1.0 (apt, unpinned; gate G9, re-checked 2026-11-04). health-check serves static files only on :8080 under /health/, reached only through the bastion's web_routes: GET and HEAD, autoindex and server_tokens off, no libnginx-mod-* package and no module loaded, no proxy, fastcgi, uwsgi, scgi, grpc, dav, charset, rewrite, mail or stream directive, no HTTP/2 or 3 (asserted by the Dockerfile on nginx -T), so NVD's module CVEs on 1.26.3 (proxy_v2, grpc, charset, rewrite) have no code path there. The Debian tracker lists only 2 unimportant trixie issues (CVE-2009-4487, CVE-2013-0337; 2026-11-04)"

[[platform]]
name = "pg_cron (PostgreSQL extension, postgres brick)"
version = "1.6.8"
source = "bricks/postgres/Dockerfile ARG PG_CRON_PACKAGE=1.6.8-1.pgdg13+2 (PGDG postgresql-18-cron, pinned and asserted by dpkg-query at build; v0.4 gate G5) in postgres 0.5.0. No CPE exists on NVD (checked 2026-10-30), no OSV ecosystem; watch github.com/citusdata/pg_cron (no repository advisory as of 2026-10-30) and the Debian tracker's pg-cron"

[[platform]]
name = "cron (Debian, postgres and health-check bricks)"
version = "3.0pl1-197"
source = "Debian cron and cron-daemon-common 3.0pl1-197 in postgres 0.5.0 (apt, unpinned; gate G5) and health-check 0.1.0 (gate G9: postgres's spool crontab only, /etc/crontab and the cron.d and run-parts entries removed; re-checked 2026-11-04). Debian's own Vixie cron fork, versioned by its Debian revision: no CPE fits (none for vixie cron on NVD, checked 2026-10-30; NVD's 3.0 hits such as CVE-2019-9706 are fixed in 3.0pl1-133). The Debian tracker's source package cron is the watch (no open issue in trixie as of 2026-10-30; OSV Debian:13 cron 3.0pl1-197 clean 2026-11-04)"

[[platform]]
name = "pgBadger (PostgreSQL log analyser, postgres brick)"
version = "13.3"
source = "PGDG pgbadger 13.3-1.pgdg13+1 in postgres 0.5.0 (bricks/postgres/Dockerfile, apt, unpinned, installed with postgresql-${PG_MAJOR}; build asserts pgbadger --version), in the image since 0.3.0 (13.2 until 0.4.0); Perl script on Debian perl 5.40.1-6+deb13u1, which also runs vault-post (core HTTP::Tiny 0.088) from 0.5.0. Players run it by hand on the file log, writing HTML reports in their home (brick.yaml report_tools); no daemon, no listener. No CPE exists on NVD and NVD has no CVE mentioning pgbadger (checked 2026-10-31); no OSV record (Debian:13 query clean), no GitHub advisory and no SECURITY.md on github.com/darold/pgbadger, no issue on the Debian tracker's source package pgbadger. 13.3 (2026-11-03) is upstream's latest release, a maintenance release with no security note (it sanitises database names used as paths with --explode; checked 2026-11-03). Watch: darold/pgbadger releases and the Debian tracker"

[[platform]]
name = "pgCluu (PostgreSQL performance reports, postgres brick)"
version = "5.0"
source = "bricks/postgres/Dockerfile ARG PG_CLUU_PACKAGE=5.0-1.pgdg13+1 (PGDG pgcluu, pinned and asserted by dpkg-query at build; gate G9) in postgres 0.5.0 from its 2026-11-04 rebuild, not Debian's 4.0-1 (no PostgreSQL 17/18 collection). Perl scripts run by hand by the player (pgcluu_collectd --disable-sar --disable-pidstat, then pgcluu -o in their home), never a daemon, no sudo rule; its report CGI /usr/lib/cgi-bin/pgcluu.cgi and /etc/apache2/conf-available/pgcluu.conf deleted and asserted gone, no web server, no sysstat. Brings Debian libjs-jquery 3.6.1+dfsg+~3.5.14-1 and libjs-underscore 1.13.4~dfsg+~1.11.4-3 for the HTML report: underscore 1.13.4 is affected by CVE-2026-27601 (GHSA-qpx9-hpmf-5gmw, unbounded recursion in _.flatten and _.isEqual, fix 1.13.8; open in trixie), a denial of service in the browser of whoever opens a report built from their own collection: not reachable as an attack. No CPE exists on NVD (checked 2026-11-04); OSV Debian:13 pgcluu clean, no GitHub advisory on github.com/darold/pgcluu. Watch: darold/pgcluu releases, the Debian tracker's pgcluu and underscore"

[[platform]]
name = "check_postgres (health-check brick)"
version = "2.26.0"
source = "bricks/health-check/Dockerfile ARG CHECK_POSTGRES_PACKAGE=2.26.0-2 (Debian check-postgres, no recommends, pinned and asserted by dpkg-query and --version at build; gate G9) in health-check 0.1.0. Perl script on Debian perl 5.40.1-6+deb13u1 over Debian psql/libpq 17.11 (entry above), run as postgres from its spool crontab every five minutes (--timeout=15, each run bounded at 30 s) against the scenario's PostgreSQL 18 nodes over TLS, the password in PGPASSFILE, never --dbpass. No CPE exists on NVD (checked 2026-11-04); OSV Debian:13 check-postgres clean, no issue on the Debian tracker. Upstream (github.com/bucardo/check_postgres) dormant since its 2.26.0 release in 2023: a future fix may come only as a Debian patch. Watch: the Debian tracker's check-postgres and perl"

[[platform]]
name = "pgaudit (PostgreSQL extension, postgres brick)"
version = "18.0"
source = "bricks/postgres/Dockerfile ARG PG_AUDIT_PACKAGE=18.0-3.pgdg13+1 (PGDG postgresql-18-pgaudit, pinned and asserted by dpkg-query and pgaudit.so at build; v0.5 gate G5) in postgres 0.5.0, from v0.5. Writes DDL, WRITE and ROLE lines to the file log the players read; 18.0 redacts passwords in role statements itself (password <REDACTED>), PostgreSQL's own statement logging does not, so the password sessions run with pgaudit.log and statement logging off. No CPE exists on NVD (checked 2026-11-03), no OSV ecosystem (CVE-2025-23413 is F5's, not pgaudit's); watch github.com/pgaudit/pgaudit security advisories and releases"

[[platform]]
name = "cmark-gfm (bastion starter-pack page)"
version = "0.29.0.gfm.13"
cpe = "cpe:2.3:a:github:cmark-gfm"
source = "Debian cmark-gfm, libcmark-gfm0.29.0.gfm.13 and libcmark-gfm-extensions0.29.0.gfm.13 0.29.0.gfm.13-4 in bastion 0.5.0 (apt, unpinned; gate G13), run at start-up as cmark-gfm -e table in safe mode (never --unsafe) on the GM's starter-pack files. Watch: upstream silent since 2023 (last release 0.29.0.gfm.13, July 2023); github/cmark-gfm took two commits since (2025-12 a cmake bump, 2026-09 PR #394 an undefined-behaviour fix in the autolink extension, no advisory, not enabled here) but no release, so a future fix may come only as a Debian patch"

[[platform]]
name = "Prometheus"
version = "3.13.5"
cpe = "cpe:2.3:a:prometheus:prometheus"
source = "bricks/prometheus/Dockerfile ARG PROMETHEUS_VERSION, sha256-pinned release tarball. 3.13 is an LTS line, supported to 2027-07-31 (checked at gate G9, 2026-11-04): stay on 3.13.x patch releases until then. From v0.5 a scenario's scrape configuration may add a pgwatch job (<node>:9188, the overlay only). Embedded modules: bricks/prometheus/sbom/prometheus.cdx.json and promtool.cdx.json (go1.26.10; the main module as its Go tag v0.313.5, the binary's commit f497435, since its build info says v0.0.0-...+dirty, which would match every advisory). 2026-11-04, none reachable (govulncheck -mode=binary on the unstripped binaries): grpc 1.83.1 GHSA-2v4p-qf9q-27wj (gRPC server panic; Prometheus serves no gRPC, plain HTTP 9090 only), x/net/html GO-2026-6860/6866, x/crypto/openpgp GO-2026-5932 and aws-sdk-go S3 crypto GO-2022-0635/0646 (modules only, no package linked)"

[[platform]]
name = "postgres_exporter"
version = "0.20.1"
source = "bricks/postgres-exporter/Dockerfile ARG PG_EXPORTER_VERSION, sha256-pinned release tarball. No CPE exists on NVD (checked 2026-10-26); OSV Go module github.com/prometheus-community/postgres_exporter has no advisory. Embedded modules: bricks/postgres-exporter/sbom/postgres_exporter.cdx.json, built with go1.26.4 (2026-07-08): 2026-11-04, 38 advisories on stdlib, x/net, x/crypto and x/text (fixes up to Go 1.27.3, x/net 0.62.0, x/crypto 0.56.0, x/text 0.41.0), none reachable in this brick: plain HTTP/1 on 9187 (no TLS, so no HTTP/2), handlers /metrics and / only (no multipart form, no CONNECT, no file serving, no unencrypted HTTP/2), its lib/pq client on sslmode=disable (TLS client advisories moot), Linux (GO-2026-6604 is Windows-only). 0.20.1 is upstream's latest release: no fixed build exists yet"

[[platform]]
name = "pgwatch (pgwatch brick)"
version = "6.1.0"
source = "bricks/pgwatch/Dockerfile ARG PGWATCH_VERSION=6.1.0, the release tarball pgwatch_Linux_x86_64.tar.gz, ADD --checksum=sha256:8c9bb13978e6e769b2c82f304479c2840bbcb44e9a6ba8209507cdfc24a117da (gate G9; not the .deb). Only the binary is installed, /usr/local/bin/pgwatch (commit 742aaf9, go1.26.9, static, no symbol table), with its built-in metric definitions; the build asserts the banner Version: 6.1.0 (pgwatch exits 1 with no sources) and that the basic preset needs no init SQL. Run as pgwatch 990 with --web-disable=all (nothing on :8080), a Prometheus sink on :9188 (the overlay only), the basic preset, the password in PGPASSFILE; never --create-helpers or --try-create-listed-exts-if-missing. No CPE exists on NVD (checked 2026-11-04); OSV Go module github.com/cybertec-postgresql/pgwatch/v6 6.1.0 and pgx/v5 5.11.0: 0 advisories. Embedded modules (osv-scanner --x-plugins=go/binary on the extracted binary, 45 packages, 2026-11-04): GO-2026-6809 (stdlib crypto/x509 distrust list, fix go1.26.10; the game's per-game CA has no public intermediate) and GO-2026-6860/GO-2026-6866 (golang.org/x/net/html 0.61.0, fix 0.62.0; package not linked): none reachable. The daily sweep reads its modules from bricks/pgwatch/sbom/pgwatch.cdx.json (45 components, 2026-11-04: the same three findings). Watch: github.com/cybertec-postgresql/pgwatch releases and security advisories"

[[platform]]
name = "Grafana"
version = "13.2.4"
cpe = "cpe:2.3:a:grafana:grafana"
source = "bricks/grafana/Dockerfile ARG GRAFANA_VERSION, sha256-pinned release tarball. grafana 0.3.0 adds an optional pgwatch dashboard seed (JSON over the Prometheus series, no plugin; no package change, 2026-11-04). 13.2.5 (2026-10-27) is a security release, not yet on NVD or OSV (2026-11-04): CVE-2026-100105 (alerting contact point authorization bypass, 7.7), CVE-2026-103506 (SSO settings authorization bypass, 8.9), CVE-2026-88858 (server-side expression parser DoS, 6.5), CVE-2026-88967 (Azure Monitor token disclosure via SSRF, 7.7), per grafana.com/security/security-advisories. Embedded modules: bricks/grafana/sbom/grafana.cdx.json (go1.26.9; main module left out: built as (devel), and OSV's Go records for github.com/grafana/grafana have no fixed version, so NVD above is its check) and gpx_grafana-prometheus-datasource_linux_amd64.cdx.json (the kept bundled plugin's backend, go1.27.1, a child process on loopback gRPC with go-plugin's mTLS, an HTTP/1 client to Prometheus). 2026-11-04: kin-openapi 0.144.0 (7 GHSAs, fix 0.149.0; Grafana 13.2.5 carries 0.151.0) and go-jose 4.1.4 (3 GHSAs, fix 4.1.6; in Grafana 13.3.0, not 13.2.5) reachability unknown (not in the Go vulnerability database, so no symbol check), both behind Grafana's login, players being admin; crypto/x509 GO-2026-6809 symbol present but only outbound HTTPS verifies public chains; the plugin's stdlib 1.27.1 and x/net 0.59.0 advisories are server-side HTTP/2, CONNECT, multipart, Range or Windows paths it does not run"

[[platform]]
name = "Python"
version = "3.13.5"
cpe = "cpe:2.3:a:python:python"
source = "Debian python3.13 3.13.5-2+deb13u5 (apt, unpinned): scheduler 0.3.0 (with python3-psycopg 3.2.6, python3-yaml 6.0.2), api 0.1.0 (with python3-yaml 6.0.2 and libyaml-0-2 0.2.5-2, safe loading only, gate G11.1; its PyPI wheels in bricks/api/requirements.txt, no pip in the image) and the GM host's python3 running tools/gmctl"
