#!/bin/sh
# gm-entrypoint: container entrypoint of the db_audit_gm scheduler brick.
# DO NOT TAMPER. Root-owned and read-only (v0.3 master spec 7.1; capture W1
# items 5 and 7).
#
# Runs as root at every container start, then execs s6-overlay's /init:
#   1. empties /run (a named volume: a stack file's tmpfs is noexec, and
#      s6-overlay needs an executable /run), fills /run/gm-accounts with
#      the account files of the write policy (v0.5: `no-access` has no
#      `player` account, master spec 10.2) and creates the runtime dirs;
#   2. generates this container's sshd host key under /run;
#   3. checks the secrets (the role passwords and, v0.5, the HTTP
#      credentials `http_<name>`: one line, no space) and that the
#      schedule's seed config is there (it is read in place by the s6
#      service, never copied);
#   4. checks GM_WRITE_POLICY and GM_WRITE_OVERRIDES and writes
#      /run/gm/write-policy, read by gm-reload-scheduler (sudo resets the
#      environment);
#   5. seeds the repository (queries.yaml, builders/, scripts/) and
#      jobs.yaml from /opt/gm/seed once (marker
#      /var/lib/gm-state/.gm-seeded, on its own root-owned volume);
#   6. applies the write policy's owner and modes to every seeded file and
#      directory, seeding or not (contents untouched);
#   7. sets the log, state, marker and home owners and modes.
# On a `no-access` node (v0.5) there is no `player`: no account, so no SSH
# login and no sudo wrapper anyone may run; its key is not required; the
# home volume is root's, 0700; sshd still runs (node health's `default`).
set -eu

REPO=/srv/scheduler/repository
JOBS=/srv/scheduler/jobs
LOGDIR=/var/log/scheduler
STATE=/var/lib/scheduler
STATE_DIR=/var/lib/gm-state
MARKER=$STATE_DIR/.gm-seeded
LOAD_MARKER=$STATE_DIR/load-started
SEED_DIR=/opt/gm/seed
SECRETS_DIR=/opt/gm/secrets
PLAYER_HOME=/home/player

log() { printf 'gm-entrypoint: %s\n' "$*" >&2; }
die() { log "fatal: $*"; exit 1; }
# chmod_setgid <path> <group> <mode>: chmod run with <group> as gid, so the
# kernel keeps the setgid bit without CAP_FSETID (root is not in <group>).
chmod_setgid() { setpriv --regid="$2" --clear-groups -- chmod "$3" "$1"; }
prog() { python3 -I -m gm_scheduler "$@"; }

# --- 1. /run, the account files ----------------------------------------------
cd /run
find . -mindepth 1 -maxdepth 1 -exec rm -rf -- {} +
cd /
# /etc/passwd, group, shadow, gshadow link into /run/gm-accounts: nothing
# may look a name up before they are back (numeric owners, cp -p)
case ${GM_WRITE_POLICY:-fixable} in
    no-access) ACCOUNTS=no-access ;;
    *) ACCOUNTS=player ;;
esac
mkdir -m 0755 /run/gm-accounts
for f in passwd group shadow gshadow; do
    cp -p "/etc/gm-accounts/$ACCOUNTS/$f" "/run/gm-accounts/$f"
done
chown root:root /run
chmod 0755 /run
install -d -o root -g root -m 0755 /run/sshd
install -d -o root -g root -m 0700 /run/sshd-keys
install -d -o root -g root -m 0700 /run/gm
install -d -o root -g root -m 1777 /run/tmp
# the program's status and what it loaded: root and the validator read them
install -d -o scheduler -g scheduler -m 0750 /run/scheduler

# --- 2. sshd host key ---------------------------------------------------
ssh-keygen -q -t ed25519 -N '' -C '' -f /run/sshd-keys/ssh_host_ed25519_key

# --- 3. secrets and the schedule -----------------------------------------
if [ "$ACCOUNTS" = player ]; then
    [ -s "$SECRETS_DIR/player_ssh_pubkey" ] || die "secret $SECRETS_DIR/player_ssh_pubkey is missing or empty"
fi
for f in "$SECRETS_DIR"/role_*_password "$SECRETS_DIR"/http_*; do
    [ -e "$f" ] || continue
    name=${f#"$SECRETS_DIR"/}
    case $name in
        role_*) case ${name#role_} in
                    *[!a-z0-9_]*|'') die "secret $name: the role in its name is not [a-z_][a-z0-9_]*" ;;
                esac ;;
        # an HTTP credential (v0.5, spec D347): http_<name>, [a-z][a-z0-9_]*
        *) case ${name#http_} in
               [a-z]*) case ${name#http_} in *[!a-z0-9_]*) die "secret $name: the credential in its name is not [a-z][a-z0-9_]*" ;; esac ;;
               *) die "secret $name: the credential in its name is not [a-z][a-z0-9_]*" ;;
           esac ;;
    esac
    value=$(cat "$f")
    case $value in
        '') die "secret $name is empty" ;;
        *'
'*) die "secret $name must be a single line" ;;
        *' '*|*'	'*) die "secret $name must not hold a space" ;;
    esac
done
unset value
[ -f "$SEED_DIR/schedule.yaml" ] || die "seed file $SEED_DIR/schedule.yaml is missing"

# --- 4. the write policy --------------------------------------------------
if ! problem=$(prog write-policy 2>&1); then
    die "${problem:-the write policy could not be written}"
fi

# --- 5. seed once -----------------------------------------------------------
# The marker lives on its own volume (gmstate), root-owned: neither player
# (group schedconf) nor scheduler can remove, rename or replace it.
chown root:root "$STATE_DIR"
chmod 0755 "$STATE_DIR"
chown scheduler:schedconf "$REPO" "$JOBS"
if [ ! -e "$MARKER" ]; then
    for f in queries.yaml jobs.yaml; do
        [ -f "$SEED_DIR/$f" ] || die "seed file $SEED_DIR/$f is missing"
    done
    install -o scheduler -g schedconf -m 0644 "$SEED_DIR/queries.yaml" "$REPO/queries.yaml"
    for d in builders scripts; do
        install -d -o scheduler -g schedconf -m 0755 "$REPO/$d"
        [ -d "$SEED_DIR/$d" ] || continue
        for f in "$SEED_DIR/$d"/*; do
            [ -f "$f" ] || continue
            install -o scheduler -g schedconf -m 0644 "$f" "$REPO/$d/${f##*/}"
        done
    done
    install -o scheduler -g schedconf -m 0644 "$SEED_DIR/jobs.yaml" "$JOBS/jobs.yaml"
    date -u '+seeded %Y-%m-%dT%H:%M:%SZ from /opt/gm/seed (DO NOT TAMPER)' > "$MARKER"
    chown root:root "$MARKER"
    chmod 0444 "$MARKER"
    log "seeded $REPO and $JOBS from $SEED_DIR"
fi

# --- 6. the write policy's owner and modes ------------------------------------
if ! notes=$(prog restore 2>&1); then
    die "the owner and modes of the seeded files could not be set: $notes"
fi
[ -z "$notes" ] || log "left alone: $(printf '%s' "$notes" | tr '\n' ';')"
log "write policy: $(tr '\n' ' ' < /run/gm/write-policy)"

# --- 7. log, state, markers, home ---------------------------------------------
chown scheduler:schedconf "$LOGDIR"
chmod_setgid "$LOGDIR" schedconf 2750
if [ -e "$LOGDIR/scheduler.log" ] && [ ! -L "$LOGDIR/scheduler.log" ]; then
    chown scheduler:schedconf "$LOGDIR/scheduler.log"
    chmod 0640 "$LOGDIR/scheduler.log"
fi
chown scheduler:scheduler "$STATE"
chmod 0750 "$STATE"
if [ -e "$LOAD_MARKER" ]; then
    chown root:scheduler "$LOAD_MARKER"
    chmod 0440 "$LOAD_MARKER"
fi
if [ "$ACCOUNTS" = player ]; then
    chown player:player "$PLAYER_HOME"
    chmod 0750 "$PLAYER_HOME"
else
    chown root:root "$PLAYER_HOME"
    chmod 0700 "$PLAYER_HOME"
fi
log "accounts: $ACCOUNTS$( [ "$ACCOUNTS" = no-access ] && printf ' (no player account)' )"

exec /init "$@"
