#!/bin/sh
# gm-restart-pgwatch: check, then restart pgwatch, and show what it reached.
# Usage: sudo gm-restart-pgwatch
# DO NOT TAMPER. Root-owned, read-only; allowed by /etc/sudoers.d/gm-player.
# (v0.5 master spec 7.4; as the postgres-exporter brick's
# gm-restart-exporter, v0.3 capture W1 item 5.)
#
# First restores the seeded file's owner and mode (pgwatch:pwconf, 0664
# or 0644, the directory 2775 or 2755, by the write policy in
# /run/gm/write-policy), contents untouched, never through a link: a file
# `sed -i` left owned by player gets its owner back. On a node where
# sources.yaml is not fixable (report-only), refuses with one line and
# exit 1, nothing restarted.
#
# pgwatch rereads sources.yaml every minute on its own; the wrapper applies
# an edit at once. It checks the file as the s6 service does and refuses to
# restart if it is not valid, so the running pgwatch is left alone.
# Otherwise it restarts the service through s6 (and starts it if it was
# down), waits up to 60 s for a new pgwatch to have fetched every source
# once (its bounded wait for the sources' hosts included), and prints each
# source's pgwatch_instance_up: 1 reached, 0 not reached.
set -u
PATH=/command:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export PATH
CONF=/etc/pgwatch/sources.yaml
SERVICE=/run/service/pgwatch
URL=http://127.0.0.1:9188/metrics
WAIT=60

if [ "$#" -ne 0 ]; then
    echo "usage: sudo gm-restart-pgwatch (no arguments)" >&2
    exit 2
fi

ME=gm-restart-pgwatch
cd /

# 0. Owner and mode, then the write policy.
if ! notes=$(/usr/local/sbin/gm-write-policy restore 2>&1); then
    echo "$ME: could not restore the files' owner and mode; nothing was restarted:" >&2
    printf '%s\n' "$notes" | sed 's/^/  /' >&2
    exit 2
fi
[ -z "$notes" ] || { echo "$ME: left alone:"; printf '%s\n' "$notes" | sed 's/^/  /'; }
/usr/local/sbin/gm-write-policy reloadable >/dev/null 2>&1
case $? in
    0) ;;
    1) echo "$ME: this node is report-only: its files cannot be changed, so nothing was reloaded."
       exit 1 ;;
    *) echo "$ME: cannot read the node's write policy; nothing was restarted." >&2
       exit 2 ;;
esac

pgwatch_pid() { ps -u pgwatch -o pid=,args= | awk '$2 == "/usr/local/bin/pgwatch" { print $1; exit }'; }

# 1. The file is valid for pgwatch (its own parsing), each enabled source
#    a postgresql:// URI with a host.
if ! problems=$(/usr/local/lib/gm/pgwatch-sources check); then
    echo "$ME: $CONF is not valid; pgwatch was NOT restarted:"
    printf '%s\n' "$problems" | sed 's/^/  /'
    exit 1
fi
sources=$(s6-setuidgid pgwatch /usr/bin/env -i PATH=/usr/bin:/bin HOME=/nonexistent \
    /usr/local/bin/pgwatch --sources="$CONF" source resolve 2>/dev/null | grep -c '^[^ ].*=')

# 2. Restart through s6: -r restarts a running pgwatch, -u starts one that
#    is down. Then wait for a new process whose sink reports every source.
old=$(pgwatch_pid)
s6-svc -r -u "$SERVICE" || { echo "$ME: could not signal the pgwatch service" >&2; exit 1; }
i=0
up=
while [ "$i" -lt "$((WAIT * 2))" ]; do
    sleep 0.5
    i=$((i + 1))
    new=$(pgwatch_pid)
    [ -n "$new" ] && [ "$new" != "$old" ] || continue
    metrics=$(curl -fsS -m 10 "$URL" 2>/dev/null) || continue
    up=$(printf '%s\n' "$metrics" | sed -n 's/^pgwatch_instance_up{dbname="\([^"]*\)"} \([0-9.e+-]*\).*$/\1 \2/p')
    [ "$(printf '%s\n' "$up" | grep -c .)" -ge "$sources" ] && [ -n "$up" ] && break
done
if [ -z "$up" ]; then
    echo "$ME: pgwatch did not report its sources within ${WAIT}s; run sudo gm-validate." >&2
    exit 1
fi
echo "$ME: pgwatch restarted with $CONF."
printf '%s\n' "$up" | while read -r source value; do
    case $value in
        1) echo "$ME: $source: pgwatch_instance_up 1: reached." ;;
        *) echo "$ME: $source: pgwatch_instance_up 0: NOT reached (address, user, or the database's own access rules)." ;;
    esac
done
exit 0
