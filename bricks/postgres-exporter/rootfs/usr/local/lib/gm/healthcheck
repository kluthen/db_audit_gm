#!/bin/sh
# Health check of the db_audit_gm postgres-exporter node (DO NOT TAMPER).
# Healthy once postgres_exporter has answered at least once in this
# container and while sshd is up. Never depends on the database it watches:
# the landing page on :9187 answers whether or not the database does, and
# asks nothing of it. After that first time, the exporter being down is the
# game's business (the validator reports it), not a reason for Swarm to
# replace the container and cut the players' SSH sessions.
PATH=/command:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
MARK=/run/gm/postgres-exporter-was-ready

[ "$(s6-svstat -o up /run/service/sshd 2>/dev/null)" = true ] || { echo "sshd is not up"; exit 1; }
if curl -fsS -o /dev/null -m 3 http://127.0.0.1:9187/ 2>/dev/null; then
    [ -e "$MARK" ] || : > "$MARK"
    exit 0
fi
[ -e "$MARK" ] && exit 0
echo "postgres_exporter has not answered yet"
exit 1
