#!/bin/sh
# gm-entrypoint: container entrypoint of the db_audit_gm bastion brick.
# DO NOT TAMPER. Root-owned and read-only (master spec 9.2).
#
# Runs as root at every container start, then execs s6-overlay's /init:
#   1. empties /run (a named volume: a stack file's tmpfs is noexec, and
#      s6-overlay needs an executable /run) and creates the runtime dirs;
#   2. creates the sshd host key in the `hostkeys` volume, once;
#   3. checks the secrets;
#   4. builds /run/gm/shadow (/etc/shadow points to it) with the hash of
#      the per-game password;
#   5. copies the starter pack from /opt/gm/starter into the player's home,
#      once, never over an existing file; an optional file the scenario
#      does not provide (data-policy.md) is skipped;
#   6. writes the player's ~/.ssh/id_ed25519 and ~/.pgpass from the secrets;
#   7. writes the web front's nginx configuration, password file and page
#      under /run/web-front, routes or none (spec D224): the page, the
#      front's home, renders the starter pack from /opt/gm/starter and
#      links to the web interfaces of GM_WEB_ROUTES when it has any.
set -eu

SECRETS_DIR=/opt/gm/secrets
STARTER_DIR=/opt/gm/starter
STARTER_FILES="README.md story.md issues.md"   # seed.files: required
STARTER_OPTIONAL="data-policy.md"               # seed.optional: absent without governance:
HOSTKEY_DIR=/var/lib/gm-sshd-keys
SHADOW_BASE=/usr/local/lib/gm/shadow.base
PLAYER_HOME=/home/player
WEB_DIR=/run/web-front
WEB_PORT=8080
WEB_USER=player                     # the basic-authentication user name
WEB_ACCOUNT=www-data                # nginx runs as this account

log() { printf 'gm-entrypoint: %s\n' "$*" >&2; }
die() { log "fatal: $*"; exit 1; }
# read_secret <name>: the secret's content, trailing newlines removed;
# fails unless it is a single non-empty line.
read_secret() {
    [ -s "$SECRETS_DIR/$1" ] || die "secret $SECRETS_DIR/$1 is missing or empty"
    v=$(cat "$SECRETS_DIR/$1")
    case $v in
        '') die "secret $1 is empty" ;;
        *'
'*) die "secret $1 must be a single line" ;;
    esac
    printf '%s' "$v"
}
# put_file <path> <mode>: stdin into <path>, owned by player; whatever the
# player left at <path> (a symlink, a directory) is removed first.
put_file() {
    rm -rf -- "$1"
    (umask 077; cat > "$1")
    chown player:player "$1"
    chmod "$2" "$1"
}

# --- 1. /run ------------------------------------------------------------
# Leftovers of a previous container (s6 state, sockets, pid files) must
# not survive into this one.
cd /run
find . -mindepth 1 -maxdepth 1 -exec rm -rf -- {} +
cd /
chown root:root /run
chmod 0755 /run
install -d -o root -g root -m 0755 /run/sshd
install -d -o root -g root -m 0700 /run/gm
install -d -o root -g root -m 1777 /run/tmp

# --- 2. sshd host key ---------------------------------------------------
# Kept in its own volume: the players' own SSH clients remember it, so it
# must survive a container replacement.
chown root:root "$HOSTKEY_DIR"
chmod 0700 "$HOSTKEY_DIR"
if [ ! -s "$HOSTKEY_DIR/ssh_host_ed25519_key" ]; then
    rm -f "$HOSTKEY_DIR/ssh_host_ed25519_key" "$HOSTKEY_DIR/ssh_host_ed25519_key.pub"
    ssh-keygen -q -t ed25519 -N '' -C '' -f "$HOSTKEY_DIR/ssh_host_ed25519_key"
    log "sshd host key created"
fi

# --- 3. secrets ---------------------------------------------------------
player_password=$(read_secret player_password)
dba_password=$(read_secret dba_password)
[ -s "$SECRETS_DIR/player_ssh_key" ] || die "secret $SECRETS_DIR/player_ssh_key is missing or empty"
ssh-keygen -y -f "$SECRETS_DIR/player_ssh_key" >/dev/null 2>&1 \
    || die "secret player_ssh_key is not an unencrypted OpenSSH private key"

# --- 4. password ----------------------------------------------------------
# The root filesystem is read-only, so /etc/shadow is a symlink to
# /run/gm/shadow, rebuilt here at every start from the image's copy.
hash=$(printf '%s\n' "$player_password" | openssl passwd -6 -stdin)
case $hash in '$6$'*) ;; *) die "could not hash the player password" ;; esac
GM_HASH=$hash awk -F: 'BEGIN { OFS = ":" } $1 == "player" { $2 = ENVIRON["GM_HASH"] } { print }' \
    "$SHADOW_BASE" > /run/gm/shadow
grep -q '^player:\$6\$' /run/gm/shadow || die "could not set the player password"
chown root:shadow /run/gm/shadow
chmod 0640 /run/gm/shadow
unset player_password hash

# --- 5. player's home and starter pack -------------------------------------
chown player:player "$PLAYER_HOME"
chmod 0750 "$PLAYER_HOME"
for f in $STARTER_FILES; do
    [ -f "$STARTER_DIR/$f" ] || die "starter pack file $STARTER_DIR/$f is missing"
done
if [ ! -e "$PLAYER_HOME/.gm-starter-copied" ]; then
    for f in $STARTER_FILES $STARTER_OPTIONAL; do
        t=$PLAYER_HOME/$f
        if [ ! -f "$STARTER_DIR/$f" ]; then
            log "starter pack: $f not provided by the scenario, skipped"
        elif [ -e "$t" ] || [ -L "$t" ]; then
            log "starter pack: $t exists, left as it is"
        else
            install -o player -g player -m 0644 "$STARTER_DIR/$f" "$t"
        fi
    done
    date -u '+starter pack copied %Y-%m-%dT%H:%M:%SZ from /opt/gm/starter (DO NOT TAMPER)' \
        > "$PLAYER_HOME/.gm-starter-copied"
    chown root:root "$PLAYER_HOME/.gm-starter-copied"
    chmod 0444 "$PLAYER_HOME/.gm-starter-copied"
    log "starter pack copied into $PLAYER_HOME"
fi

# --- 6. inner-hop key and ~/.pgpass, rewritten at every start ---------------
if [ -L "$PLAYER_HOME/.ssh" ] || { [ -e "$PLAYER_HOME/.ssh" ] && [ ! -d "$PLAYER_HOME/.ssh" ]; }; then
    rm -f -- "$PLAYER_HOME/.ssh"
fi
install -d -o player -g player -m 0700 "$PLAYER_HOME/.ssh"
# OpenSSH refuses a private key without its final newline: add it back.
printf '%s\n' "$(cat "$SECRETS_DIR/player_ssh_key")" | put_file "$PLAYER_HOME/.ssh/id_ed25519" 0600
pw_pgpass=$(printf '%s' "$dba_password" | sed 's/[\\:]/\\&/g')
printf '*:*:*:dba:%s\n' "$pw_pgpass" | put_file "$PLAYER_HOME/.pgpass" 0600
unset dba_password pw_pgpass

# --- 7. web front -----------------------------------------------------------
# The front runs in every game (spec D224), routes or none: its home, /, is
# the starter-pack page; its routes, when GM_WEB_ROUTES has any, publish
# the web interfaces. GM_WEB_ROUTES: the brick parameter web_routes as
# `name=node:port` tokens, space-separated (capture W2-A). Route <name> is
# served at /<name>/ and the path is forwarded unchanged: the upstream
# serves under its own /<name>/.
# The front's own answers (the page at /, the redirect of /<name> to
# /<name>/, 404 elsewhere) are static files under $WEB_DIR/www, served in
# nginx's content phase: a `return` would answer in the rewrite phase,
# before auth_basic in the access phase, so without the password.
web_names=
web_locations=
set -f
for token in ${GM_WEB_ROUTES:-}; do
    printf '%s\n' "$token" \
        | grep -Eqx '[a-z]([a-z0-9-]{0,61}[a-z0-9])?=[a-z]([a-z0-9-]{0,61}[a-z0-9])?:[0-9]{1,5}' \
        || die "GM_WEB_ROUTES: '$token' is not name=node:port"
    name=${token%%=*}
    target=${token#*=}
    port=${target##*:}
    { [ "$port" -ge 1 ] && [ "$port" -le 65535 ]; } || die "GM_WEB_ROUTES: '$token': port out of range"
    case " $web_names " in *" $name "*) die "GM_WEB_ROUTES: route $name given twice" ;; esac
    web_names="$web_names $name"
    var=gm_upstream_$(printf '%s' "$name" | tr - _)
    # = /<name>: without it, nginx's own 301 of /<name> to the proxy_pass
    # location /<name>/ would answer before auth_basic (find-config
    # phase); the static directory www/routes/<name>/ answers instead.
    web_locations="$web_locations
        location = /$name { root $WEB_DIR/www/routes; }
        location /$name/ {
            set \$$var $target;
            proxy_pass http://\$$var;
        }"
done
set +f

install -d -o root -g "$WEB_ACCOUNT" -m 0750 "$WEB_DIR"
install -d -o "$WEB_ACCOUNT" -g "$WEB_ACCOUNT" -m 0700 "$WEB_DIR/tmp"
# Password file: user `player`, SHA-512 crypt of the tools password,
# readable by nginx's account only.
tools_password=$(read_secret tools_password)
hash=$(printf '%s\n' "$tools_password" | openssl passwd -6 -stdin)
case $hash in '$6$'*) ;; *) die "could not hash the tools password" ;; esac
printf '%s:%s\n' "$WEB_USER" "$hash" > "$WEB_DIR/htpasswd"
chown root:"$WEB_ACCOUNT" "$WEB_DIR/htpasswd"
chmod 0440 "$WEB_DIR/htpasswd"
unset tools_password hash
# Static answers: www/index.html (the page), www/not-found.txt, and
# www/routes/<name>/, one empty directory per route, for which nginx's
# static module answers /<name> with a 301 to /<name>/.
install -d -o root -g "$WEB_ACCOUNT" -m 0750 "$WEB_DIR/www" "$WEB_DIR/www/routes"
for name in $web_names; do
    install -d -o root -g "$WEB_ACCOUNT" -m 0750 "$WEB_DIR/www/routes/$name"
done
printf 'No web interface at this path; see /\n' > "$WEB_DIR/www/not-found.txt"

# The page (spec D221, D222): the starter pack as handed over, from
# $STARTER_DIR, never the players' copies in their home, rendered at each
# start. Its elements, in page order, one line each:
#   <kind> <id> <source> <title>
# kind `markdown`: the starter-pack file <source>, rendered by cmark-gfm
#   with the table extension; raw HTML is not passed through (its safe
#   default: never --unsafe); present when the file is there;
# kind `routes`: the links to the web interfaces; present when
#   GM_WEB_ROUTES has a route.
# An absent element leaves nothing: no section, no link to it. A later
# element (a reporting tool) joins by a line here, a new kind by its own
# branch in page_element.
PAGE_ELEMENTS='markdown readme README.md README
markdown story story.md Story
markdown issues issues.md Issues
markdown data-policy data-policy.md Data policy
routes web-interfaces - Web interfaces'
# page_element <kind> <id> <source> <title>: the element's section on
# stdout; exit 1 when the element is absent.
page_element() {
    case $1 in
        markdown)
            [ -f "$STARTER_DIR/$3" ] || return 1
            printf '<section id="%s">\n' "$2"
            cmark-gfm -e table "$STARTER_DIR/$3" || die "could not render $STARTER_DIR/$3"
            printf '</section>\n' ;;
        routes)
            [ -n "$web_names" ] || return 1
            printf '<section id="%s">\n<h1>%s</h1>\n<ul>\n' "$2" "$4"
            for name in $web_names; do
                printf '<li><a href="/%s/">%s</a></li>\n' "$name" "$name"
            done
            printf '</ul>\n</section>\n' ;;
        *) die "page element $2: unknown kind $1" ;;
    esac
}
page_nav=
: > /run/gm/page-sections.html
while read -r kind id src title; do
    if page_element "$kind" "$id" "$src" "$title" >> /run/gm/page-sections.html; then
        page_nav="$page_nav<li><a href=\"#$id\">$title</a></li>
"
    fi
done <<EOF
$PAGE_ELEMENTS
EOF
{
    cat <<EOF
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Starter pack</title>
<style>
body { max-width: 52rem; margin: 0 auto; padding: 0 1rem 2rem; font-family: sans-serif; line-height: 1.5; }
section { border-top: 1px solid #ccc; margin-top: 2rem; }
table { border-collapse: collapse; }
th, td { border: 1px solid #ccc; padding: 0.2rem 0.5rem; text-align: left; vertical-align: top; }
pre { overflow-x: auto; background: #f4f4f4; padding: 0.5rem; }
</style>
</head>
<body>
<header>
<p>The game's starter pack, as handed over. Your own copies are in your home on the bastion.</p>
<nav>
<ul>
${page_nav}</ul>
</nav>
</header>
EOF
    cat /run/gm/page-sections.html
    printf '</body>\n</html>\n'
} > "$WEB_DIR/www/index.html"
rm -f /run/gm/page-sections.html
chown root:"$WEB_ACCOUNT" "$WEB_DIR/www/index.html" "$WEB_DIR/www/not-found.txt"
chmod 0440 "$WEB_DIR/www/index.html" "$WEB_DIR/www/not-found.txt"
unset page_nav

cat > "$WEB_DIR/nginx.conf" <<EOF
# nginx configuration of the db_audit_gm web front (DO NOT TAMPER).
# Written by gm-entrypoint at each start; routes:${web_names:- none}
worker_processes 1;
pid $WEB_DIR/tmp/nginx.pid;
error_log stderr error;
events { worker_connections 256; }
http {
    access_log off;
    server_tokens off;
    default_type text/plain;
    client_body_temp_path $WEB_DIR/tmp/client_body;
    proxy_temp_path $WEB_DIR/tmp/proxy;
    fastcgi_temp_path $WEB_DIR/tmp/fastcgi;
    uwsgi_temp_path $WEB_DIR/tmp/uwsgi;
    scgi_temp_path $WEB_DIR/tmp/scgi;
    client_max_body_size 16m;
    # Docker's embedded DNS, asked at request time: an upstream that is
    # down or replaced does not stop the front (502 until it is back).
    resolver 127.0.0.11 valid=10s ipv6=off;
    resolver_timeout 5s;
    map \$http_upgrade \$connection_upgrade { default upgrade; '' close; }
    server {
        listen $WEB_PORT;
        absolute_redirect off;
        auth_basic "db_audit_gm web front";
        auth_basic_user_file $WEB_DIR/htpasswd;
        proxy_http_version 1.1;
        proxy_read_timeout 300s;
        proxy_set_header Host \$http_host;
        # The front's credentials stop here: Grafana would read them.
        proxy_set_header Authorization "";
        proxy_set_header Upgrade \$http_upgrade;
        proxy_set_header Connection \$connection_upgrade;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \$scheme;
        # An upstream's own challenge would make the browser drop the
        # front's credentials.
        proxy_hide_header WWW-Authenticate;
        # Every answer below comes from the content phase, after
        # auth_basic; a return directive would answer before it.
        location = / {
            root $WEB_DIR/www;
            types { }
            default_type text/html;
            charset utf-8;
            try_files /index.html =404;
        }
        location = /.gm-not-found {
            internal;
            alias $WEB_DIR/www/not-found.txt;
        }
        # Any other path: 404. /<name>, a directory of www/routes, has
        # its own location below: 301 to /<name>/.
        location / {
            root $WEB_DIR/www/routes;
            error_page 404 /.gm-not-found;
        }$web_locations
    }
}
EOF
chown root:root "$WEB_DIR/nginx.conf"
chmod 0444 "$WEB_DIR/nginx.conf"
/command/s6-setuidgid "$WEB_ACCOUNT" /usr/sbin/nginx -q -t -e stderr \
    -p "$WEB_DIR/" -c "$WEB_DIR/nginx.conf" \
    || die "the web front's configuration does not load"
log "web front on port $WEB_PORT, routes:${web_names:- none}"
unset web_names web_locations

exec /init "$@"
