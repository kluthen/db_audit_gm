#!/bin/sh
# gm-entrypoint: container entrypoint of the db_audit_gm bastion brick.
# DO NOT TAMPER. Root-owned and read-only (master spec 9.2).
#
# Runs as root at every container start, then execs s6-overlay's /init:
#   1. empties /run (a named volume: a stack file's tmpfs is noexec, and
#      s6-overlay needs an executable /run) and creates the runtime dirs;
#   2. creates the sshd host key in the `hostkeys` volume, once;
#   3. checks the secrets, and writes partners.md with the partners'
#      credentials handed over in place of its {{credential:<name>}}
#      placeholders (/run/gm/starter/partners.md; v0.5, spec D365, D433),
#      failing on a name with no secret /opt/gm/secrets/http_<name>;
#   4. builds /run/gm/shadow (/etc/shadow points to it) with the hash of
#      the per-game password;
#   5. copies the starter pack from /opt/gm/starter into the player's home,
#      once, never over an existing file; an optional file the scenario
#      does not provide (data-policy.md, partners.md, data-register.md,
#      network-overview.md) is skipped; creates ~/reports/, served by the
#      front (v0.6 master spec 7.5);
#   6. writes the player's ~/.ssh/id_ed25519 and ~/.pgpass from the secrets;
#   7. writes the web front's nginx configuration, password file and pages
#      under /run/web-front, routes or none (spec D224; v0.6 master spec
#      7.1 to 7.5, capture W2 item 2): the home at / (Sites: the routes of
#      GM_WEB_ROUTES, Reports; Documents: each starter-pack file present,
#      then Tools, each brick's page), the documentation site under /docs/
#      rendered from the starter pack as handed over (/opt/gm/starter) and
#      the brick pages (/opt/gm/docs/bricks), the reports folder at
#      /reports/; a route `name=host:port:console` is cold storage's
#      console, proxied for GET / and GET /manifests alone (v0.5 master
#      spec 7.3, D363).
set -eu

SECRETS_DIR=/opt/gm/secrets
STARTER_DIR=/opt/gm/starter
STARTER_FILES="README.md story.md issues.md"   # seed.files: required
STARTER_OPTIONAL="data-policy.md partners.md data-register.md network-overview.md"   # seed.optional: each absent
                                                # unless the scenario has it
RESOLVED_DIR=/run/gm/starter        # starter files with their placeholders replaced
HOSTKEY_DIR=/var/lib/gm-sshd-keys
SHADOW_BASE=/usr/local/lib/gm/shadow.base
PLAYER_HOME=/home/player
REPORTS_DIR=$PLAYER_HOME/reports    # the stack's reports, served at /reports/ (master spec 7.5)
BRICK_DOCS_DIR=/opt/gm/docs/bricks  # the brick pages render delivers (capture W2 item 1)
WEB_DIR=/run/web-front
WEB_PORT=8080
WEB_USER=player                     # the basic-authentication user name
WEB_ACCOUNT=www-data                # nginx runs as this account

. /usr/local/lib/gm/pages.sh
log() { printf 'gm-entrypoint: %s\n' "$*" >&2; }
die() { log "fatal: $*"; exit 1; }
# read_secret <name>: the secret's content, trailing newlines removed;
# fails unless it is a single non-empty line.
read_secret() {
    [ -s "$SECRETS_DIR/$1" ] || die "secret $SECRETS_DIR/$1 is missing or empty"
    v=$(cat "$SECRETS_DIR/$1")
    case $v in
        '') die "secret $1 is empty" ;;
        *'
'*) die "secret $1 must be a single line" ;;
    esac
    printf '%s' "$v"
}
# put_file <path> <mode>: stdin into <path>, owned by player; whatever the
# player left at <path> (a symlink, a directory) is removed first.
put_file() {
    rm -rf -- "$1"
    (umask 077; cat > "$1")
    chown player:player "$1"
    chmod "$2" "$1"
}

# --- 1. /run ------------------------------------------------------------
# Leftovers of a previous container (s6 state, sockets, pid files) must
# not survive into this one.
cd /run
find . -mindepth 1 -maxdepth 1 -exec rm -rf -- {} +
cd /
chown root:root /run
chmod 0755 /run
install -d -o root -g root -m 0755 /run/sshd
install -d -o root -g root -m 0700 /run/gm
install -d -o root -g root -m 1777 /run/tmp

# --- 2. sshd host key ---------------------------------------------------
# Kept in its own volume: the players' own SSH clients remember it, so it
# must survive a container replacement.
chown root:root "$HOSTKEY_DIR"
chmod 0700 "$HOSTKEY_DIR"
if [ ! -s "$HOSTKEY_DIR/ssh_host_ed25519_key" ]; then
    rm -f "$HOSTKEY_DIR/ssh_host_ed25519_key" "$HOSTKEY_DIR/ssh_host_ed25519_key.pub"
    ssh-keygen -q -t ed25519 -N '' -C '' -f "$HOSTKEY_DIR/ssh_host_ed25519_key"
    log "sshd host key created"
fi

# --- 3. secrets ---------------------------------------------------------
player_password=$(read_secret player_password)
dba_password=$(read_secret dba_password)
[ -s "$SECRETS_DIR/player_ssh_key" ] || die "secret $SECRETS_DIR/player_ssh_key is missing or empty"
ssh-keygen -y -f "$SECRETS_DIR/player_ssh_key" >/dev/null 2>&1 \
    || die "secret player_ssh_key is not an unencrypted OpenSSH private key"

# partners.md hands over the customer's own credentials with its partners
# (spec D365, D433): each {{credential:<name>}} becomes the mounted
# http_<name>, in the home's copy and on the page alike. A name with no
# secret stops the start.
install -d -o root -g root -m 0700 "$RESOLVED_DIR"
if [ -f "$STARTER_DIR/partners.md" ]; then
    : > /run/gm/credentials
    for name in $(grep -o '{{credential:[^{}[:space:]]*}}' "$STARTER_DIR/partners.md" \
                  | sed 's/^{{credential:\(.*\)}}$/\1/' | sort -u); do
        printf '%s\n' "$name" | grep -Eqx '[a-z][a-z0-9_]{0,62}' \
            || die "partners.md: {{credential:$name}} is not a credential's name"
        [ -s "$SECRETS_DIR/http_$name" ] \
            || die "partners.md: {{credential:$name}}: no secret $SECRETS_DIR/http_$name (no third_parties: entry hands over $name)"
        value=$(read_secret "http_$name")
        printf '%s %s\n' "$name" "$value" >> /run/gm/credentials
    done
    awk 'BEGIN {
            while ((getline line < "/run/gm/credentials") > 0) {
                i = index(line, " "); value[substr(line, 1, i - 1)] = substr(line, i + 1)
            }
         }
         {
            out = ""; rest = $0
            while (match(rest, /[{][{]credential:[a-z][a-z0-9_]*[}][}]/)) {
                name = substr(rest, RSTART + 13, RLENGTH - 15)
                out = out substr(rest, 1, RSTART - 1) value[name]
                rest = substr(rest, RSTART + RLENGTH)
            }
            print out rest
         }' "$STARTER_DIR/partners.md" > "$RESOLVED_DIR/partners.md" \
        || die "could not write partners.md's credentials"
    rm -f /run/gm/credentials
    unset value
    n=$(grep -c '{{credential:' "$RESOLVED_DIR/partners.md" || true)
    [ "$n" = 0 ] || die "partners.md: a placeholder left unreplaced"
    log "partners.md: credentials written in"
fi
# starter_source <file>: the starter file as handed over, its placeholders
# replaced where it has any.
starter_source() {
    if [ -f "$RESOLVED_DIR/$1" ]; then printf '%s' "$RESOLVED_DIR/$1"; else printf '%s' "$STARTER_DIR/$1"; fi
}

# --- 4. password ----------------------------------------------------------
# The root filesystem is read-only, so /etc/shadow is a symlink to
# /run/gm/shadow, rebuilt here at every start from the image's copy.
hash=$(printf '%s\n' "$player_password" | openssl passwd -6 -stdin)
case $hash in '$6$'*) ;; *) die "could not hash the player password" ;; esac
GM_HASH=$hash awk -F: 'BEGIN { OFS = ":" } $1 == "player" { $2 = ENVIRON["GM_HASH"] } { print }' \
    "$SHADOW_BASE" > /run/gm/shadow
grep -q '^player:\$6\$' /run/gm/shadow || die "could not set the player password"
chown root:shadow /run/gm/shadow
chmod 0640 /run/gm/shadow
unset player_password hash

# --- 5. player's home and starter pack -------------------------------------
# 0751: the front's account (www-data) passes through the home to
# ~/reports/ alone, and lists nothing else in it (master spec 7.5).
chown player:player "$PLAYER_HOME"
chmod 0751 "$PLAYER_HOME"
for f in $STARTER_FILES; do
    [ -f "$STARTER_DIR/$f" ] || die "starter pack file $STARTER_DIR/$f is missing"
done
if [ ! -e "$PLAYER_HOME/.gm-starter-copied" ]; then
    for f in $STARTER_FILES $STARTER_OPTIONAL; do
        t=$PLAYER_HOME/$f
        if [ ! -f "$STARTER_DIR/$f" ]; then
            log "starter pack: $f not provided by the scenario, skipped"
        elif [ -e "$t" ] || [ -L "$t" ]; then
            log "starter pack: $t exists, left as it is"
        else
            install -o player -g player -m 0644 "$(starter_source "$f")" "$t"
        fi
    done
    date -u '+starter pack copied %Y-%m-%dT%H:%M:%SZ from /opt/gm/starter (DO NOT TAMPER)' \
        > "$PLAYER_HOME/.gm-starter-copied"
    chown root:root "$PLAYER_HOME/.gm-starter-copied"
    chmod 0444 "$PLAYER_HOME/.gm-starter-copied"
    log "starter pack copied into $PLAYER_HOME"
fi
# ~/reports/: the players' to fill, served read-only at /reports/; made
# again when it is missing or not a directory (a link is never followed:
# the front refuses symbolic links, disable_symlinks).
if [ -L "$REPORTS_DIR" ] || [ ! -d "$REPORTS_DIR" ]; then
    rm -f -- "$REPORTS_DIR"
    install -d -o player -g player -m 0755 "$REPORTS_DIR"
    log "~/reports/ created"
fi

# --- 6. inner-hop key and ~/.pgpass, rewritten at every start ---------------
if [ -L "$PLAYER_HOME/.ssh" ] || { [ -e "$PLAYER_HOME/.ssh" ] && [ ! -d "$PLAYER_HOME/.ssh" ]; }; then
    rm -f -- "$PLAYER_HOME/.ssh"
fi
install -d -o player -g player -m 0700 "$PLAYER_HOME/.ssh"
# OpenSSH refuses a private key without its final newline: add it back.
printf '%s\n' "$(cat "$SECRETS_DIR/player_ssh_key")" | put_file "$PLAYER_HOME/.ssh/id_ed25519" 0600
pw_pgpass=$(printf '%s' "$dba_password" | sed 's/[\\:]/\\&/g')
printf '*:*:*:dba:%s\n' "$pw_pgpass" | put_file "$PLAYER_HOME/.pgpass" 0600
unset dba_password pw_pgpass

# --- 7. web front -----------------------------------------------------------
# The front runs in every game (spec D224), routes or none: its home, /, is
# the starter-pack page; its routes, when GM_WEB_ROUTES has any, publish
# the web interfaces. GM_WEB_ROUTES: the brick parameter web_routes as
# `name=node:port` tokens, space-separated (capture W2-A). Route <name> is
# served at /<name>/ and the path is forwarded unchanged: the upstream
# serves under its own /<name>/.
# A token `name=host:port:console` is cold storage's console (master spec
# 7.3, spec D363; capture W4 item 1): only GET /<name>/ (to /) and GET
# /<name>/manifests (to /manifests, its query string kept) are proxied, with
# Host: <host>, the partner's hostname; any other path or method is 404.
# The front's own answers (the page at /, the redirect of /<name> to
# /<name>/, 404 elsewhere) are static files under $WEB_DIR/www, served in
# nginx's content phase: a `return` would answer in the rewrite phase,
# before auth_basic in the access phase, so without the password.
web_names=
web_locations=
set -f
for token in ${GM_WEB_ROUTES:-}; do
    printf '%s\n' "$token" \
        | grep -Eqx '[a-z]([a-z0-9-]{0,61}[a-z0-9])?=[a-z]([a-z0-9-]{0,61}[a-z0-9])?:[0-9]{1,5}(:console)?' \
        || die "GM_WEB_ROUTES: '$token' is not name=node:port (or name=host:port:console)"
    name=${token%%=*}
    target=${token#*=}
    case $name in docs|reports|status) die "GM_WEB_ROUTES: /$name/ is the front's own (v0.6 master spec 7.1)" ;; esac
    console=
    case $target in *:console) console=1; target=${target%:console} ;; esac
    port=${target##*:}
    { [ "$port" -ge 1 ] && [ "$port" -le 65535 ]; } || die "GM_WEB_ROUTES: '$token': port out of range"
    case " $web_names " in *" $name "*) die "GM_WEB_ROUTES: route $name given twice" ;; esac
    web_names="$web_names $name"
    var=gm_upstream_$(printf '%s' "$name" | tr - _)
    # = /<name>: without it, nginx's own 301 of /<name> to the proxy_pass
    # location /<name>/ would answer before auth_basic (find-config
    # phase); the static directory www/routes/<name>/ answers instead.
    if [ -n "$console" ]; then
        # proxy_set_header here replaces the server's: the front's
        # credentials still stop at the front.
        for path in / /manifests; do
            web_locations="$web_locations
        location = /$name$path {
            limit_except GET { deny all; }
            error_page 403 =404 /.gm-not-found;
            set \$$var $target;
            proxy_set_header Host ${target%:*};
            proxy_set_header Authorization \"\";
            proxy_set_header X-Real-IP \$remote_addr;
            proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto \$scheme;
            proxy_pass http://\$$var$path\$is_args\$args;
        }"
        done
        web_locations="$web_locations
        location = /$name { root $WEB_DIR/www/routes; }
        location /$name/ {
            deny all;
            error_page 403 =404 /.gm-not-found;
        }"
        continue
    fi
    web_locations="$web_locations
        location = /$name { root $WEB_DIR/www/routes; }
        location /$name/ {
            set \$$var $target;
            proxy_pass http://\$$var;
        }"
done
set +f

install -d -o root -g "$WEB_ACCOUNT" -m 0750 "$WEB_DIR"
install -d -o "$WEB_ACCOUNT" -g "$WEB_ACCOUNT" -m 0700 "$WEB_DIR/tmp"
# Password file: user `player`, SHA-512 crypt of the tools password,
# readable by nginx's account only.
tools_password=$(read_secret tools_password)
hash=$(printf '%s\n' "$tools_password" | openssl passwd -6 -stdin)
case $hash in '$6$'*) ;; *) die "could not hash the tools password" ;; esac
printf '%s:%s\n' "$WEB_USER" "$hash" > "$WEB_DIR/htpasswd"
chown root:"$WEB_ACCOUNT" "$WEB_DIR/htpasswd"
chmod 0440 "$WEB_DIR/htpasswd"
unset tools_password hash
# Static answers: www/not-found.txt, www/routes/<name>/, one empty
# directory per route (and reports/, for /reports), for which nginx's
# static module answers /<name> with a 301 to /<name>/; the pages.
install -d -o root -g "$WEB_ACCOUNT" -m 0750 "$WEB_DIR/www" "$WEB_DIR/www/routes" \
    "$WEB_DIR/www/routes/reports" "$WEB_DIR/www/docs" "$WEB_DIR/www/docs/bricks"
for name in $web_names; do
    install -d -o root -g "$WEB_ACCOUNT" -m 0750 "$WEB_DIR/www/routes/$name"
done
printf 'No web interface at this path; see /\n' | put_page "$WEB_DIR/www/not-found.txt"

# The documentation site (v0.6 master spec 7.3; spec D221, D222): the
# starter pack as handed over, from $STARTER_DIR (partners.md with its
# credentials written in), never the players' copies in their home,
# rendered at each start, one page per file present at /docs/<id>, in the
# home's order, one line each: <id> <file> <title>. An absent file leaves
# nothing: no page, no link to it.
DOCUMENTS='readme README.md README
story story.md Story
issues issues.md Issues
data-policy data-policy.md Data policy
partners partners.md Partners
data-register data-register.md Data register
network-overview network-overview.md Network overview'
doc_links=
while read -r id file title; do
    [ -f "$STARTER_DIR/$file" ] || continue
    md_page "$(starter_source "$file")" "$title" > /run/gm/page.html \
        || die "could not render $STARTER_DIR/$file"
    put_page "$WEB_DIR/www/docs/$id.html" < /run/gm/page.html
    doc_links="$doc_links<li><a href=\"/docs/$id\">$title</a></li>
"
done <<DOCS
$DOCUMENTS
DOCS
# The brick pages (master spec 7.3; capture W2 item 1): each brick's
# player documentation render delivers, /docs/bricks/<brick-id>, titled by
# its first heading.
tool_links=
for f in "$BRICK_DOCS_DIR"/*.md; do
    [ -f "$f" ] || continue
    id=$(basename "$f" .md)
    printf '%s\n' "$id" | grep -Eqx '[a-z][a-z0-9-]{0,62}' || die "$f: not a brick's page"
    title=$(md_title "$f" "$id")
    md_page "$f" "$title" > /run/gm/page.html || die "could not render $f"
    put_page "$WEB_DIR/www/docs/bricks/$id.html" < /run/gm/page.html
    tool_links="$tool_links<li><a href=\"/docs/bricks/$id\">$(printf '%s' "$title" | html_escape)</a></li>
"
done
rm -f /run/gm/page.html

# The home (master spec 7.2): a header naming the customer (the story's
# first heading), Sites (the routes, Reports), Documents (each page above),
# then Tools (each brick's page).
customer=$(md_title "$STARTER_DIR/story.md" "the customer" | html_escape)
site_links=
for name in $web_names; do
    site_links="$site_links<li><a href=\"/$name/\">$name</a></li>
"
done
site_links="$site_links<li><a href=\"/reports/\">Reports</a></li>
"
{
    page_open "$customer" home
    cat <<HOME
<header>
<h1>$customer</h1>
<p>The documents below are what $customer handed over at the mission's start. Your own copies are in your home on the bastion.</p>
</header>
<section id="sites">
<h2>Sites</h2>
<ul>
${site_links}</ul>
</section>
<section id="documents">
<h2>Documents</h2>
<ul>
${doc_links}</ul>
HOME
    if [ -n "$tool_links" ]; then
        printf '<h3>Tools</h3>\n<ul>\n%s</ul>\n' "$tool_links"
    fi
    printf '</section>\n'
    page_close
} | put_page "$WEB_DIR/www/index.html"
unset doc_links tool_links site_links customer

cat > "$WEB_DIR/nginx.conf" <<EOF
# nginx configuration of the db_audit_gm web front (DO NOT TAMPER).
# Written by gm-entrypoint at each start; routes:${web_names:- none}
worker_processes 1;
pid $WEB_DIR/tmp/nginx.pid;
error_log stderr error;
events { worker_connections 256; }
http {
    access_log off;
    server_tokens off;
    default_type text/plain;
    client_body_temp_path $WEB_DIR/tmp/client_body;
    proxy_temp_path $WEB_DIR/tmp/proxy;
    fastcgi_temp_path $WEB_DIR/tmp/fastcgi;
    uwsgi_temp_path $WEB_DIR/tmp/uwsgi;
    scgi_temp_path $WEB_DIR/tmp/scgi;
    client_max_body_size 16m;
    # Docker's embedded DNS, asked at request time: an upstream that is
    # down or replaced does not stop the front (502 until it is back).
    resolver 127.0.0.11 valid=10s ipv6=off;
    resolver_timeout 5s;
    map \$http_upgrade \$connection_upgrade { default upgrade; '' close; }
    server {
        listen $WEB_PORT;
        absolute_redirect off;
        auth_basic "db_audit_gm web front";
        auth_basic_user_file $WEB_DIR/htpasswd;
        proxy_http_version 1.1;
        proxy_read_timeout 300s;
        proxy_set_header Host \$http_host;
        # The front's credentials stop here: Grafana would read them.
        proxy_set_header Authorization "";
        proxy_set_header Upgrade \$http_upgrade;
        proxy_set_header Connection \$connection_upgrade;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \$scheme;
        # An upstream's own challenge would make the browser drop the
        # front's credentials.
        proxy_hide_header WWW-Authenticate;
        # Every answer below comes from the content phase, after
        # auth_basic; a return directive would answer before it.
        location = / {
            root $WEB_DIR/www;
            types { }
            default_type text/html;
            charset utf-8;
            try_files /index.html =404;
        }
        location = /.gm-not-found {
            internal;
            alias $WEB_DIR/www/not-found.txt;
        }
        # The documentation site (master spec 7.3): /docs/<id> and
        # /docs/bricks/<brick-id>, rendered above.
        location /docs/ {
            root $WEB_DIR/www;
            types { }
            default_type text/html;
            charset utf-8;
            try_files \$uri.html =404;
            error_page 404 /.gm-not-found;
        }
        # The reports folder (master spec 7.5): read-only, a listing, nothing
        # outside it (no symbolic link followed: 404), its pages sandboxed
        # away from the origin Grafana shares.
        location = /reports { root $WEB_DIR/www/routes; }
        location /reports/ {
            alias $REPORTS_DIR/;
            limit_except GET { deny all; }
            autoindex on;
            disable_symlinks on;
            include /etc/nginx/mime.types;
            default_type application/octet-stream;
            add_header Content-Security-Policy "sandbox allow-scripts" always;
            error_page 403 404 =404 /.gm-not-found;
        }
        # Any other path: 404. /<name>, a directory of www/routes, has
        # its own location below: 301 to /<name>/.
        location / {
            root $WEB_DIR/www/routes;
            error_page 404 /.gm-not-found;
        }$web_locations
    }
}
EOF
chown root:root "$WEB_DIR/nginx.conf"
chmod 0444 "$WEB_DIR/nginx.conf"
/command/s6-setuidgid "$WEB_ACCOUNT" /usr/sbin/nginx -q -t -e stderr \
    -p "$WEB_DIR/" -c "$WEB_DIR/nginx.conf" \
    || die "the web front's configuration does not load"
log "web front on port $WEB_PORT, routes:${web_names:- none}"
unset web_names web_locations

exec /init "$@"
