#!/bin/sh
# gm-restart-db: restart PostgreSQL. Usage: sudo gm-restart-db
# DO NOT TAMPER. Root-owned, read-only; allowed by /etc/sudoers.d/gm-player.
# First gives the seeded files (postgresql.conf, pg_hba.conf) their owner
# and mode back (postgres:pgconf, 0664; v0.3 master spec 7.3). Checks
# that the configuration loads and leaves room for the reserved
# connections, and refuses to restart if not, so a typo does not take the
# server down. The restart goes through s6 (fast shutdown, then start);
# the container keeps running.
set -u
PATH=/command:/usr/sbin:/usr/bin:/sbin:/bin
export PATH
PGBIN=/usr/lib/postgresql/18/bin
PGDATA=/var/lib/postgresql/18/data
SERVICE=/run/service/postgres
WAIT=60
RESERVED=2    # reserved_connections, as in s6-rc.d/postgres/run

if [ "$#" -ne 0 ]; then
    echo "usage: sudo gm-restart-db (no arguments)" >&2
    exit 2
fi

as_postgres() { runuser -u postgres -- env HOME=/var/lib/postgresql "$@"; }
# setting <name>: the value the live files give it, with the run script's
# command line (s6-rc.d/postgres/run).
setting() {
    as_postgres "$PGBIN/postgres" -D "$PGDATA" \
        -c config_file=/etc/postgresql/postgresql.conf \
        -c hba_file=/etc/postgresql/pg_hba.conf \
        -c reserved_connections=$RESERVED -C "$1" 2>&1
}
# restore_seeded <file>...: owner postgres:pgconf, mode 0664 (the database
# node is fixable only), content untouched. Opened without following a
# symlink and changed through the open file, so a player's symlink or a
# swap during the change never redirects root's chown or chmod; anything
# but a regular file is left alone. Same code in gm-entrypoint.
restore_seeded() {
    perl -e '
        use strict; use warnings; use Fcntl qw(O_RDONLY O_NOFOLLOW O_NONBLOCK);
        my $uid = getpwnam("postgres"); my $gid = getgrnam("pgconf");
        defined $uid && defined $gid or die "no postgres or pgconf\n";
        for my $p (@ARGV) {
            sysopen(my $fh, $p, O_RDONLY | O_NOFOLLOW | O_NONBLOCK) or next;
            if (-f $fh) {
                chown($uid, $gid, $fh) or warn "chown $p: $!\n";
                chmod(0664, $fh) or warn "chmod $p: $!\n";
            }
            close($fh);
        }' "$@"
}

# 0. The seeded files' owner and mode as seeded, before anything reads
# them (an in-place edit such as `sed -i` leaves a file owned by player).
restore_seeded /etc/postgresql/postgresql.conf /etc/postgresql/pg_hba.conf

# 1. postgresql.conf loads (syntax, names, values), and max_connections
#    exceeds the two reserves, without which the server does not start.
if ! out=$(setting data_directory); then
    echo "gm-restart-db: postgresql.conf does not load; PostgreSQL was NOT restarted:"
    printf '%s\n' "$out" | sed 's/^/  /'
    exit 1
fi
sup=
maxc=$(setting max_connections) && sup=$(setting superuser_reserved_connections) || maxc=
case $maxc$sup in
    *[!0-9]*|'') ;;     # not read: the start itself reports it
    *)
        if [ "$maxc" -le $((sup + RESERVED)) ]; then
            echo "gm-restart-db: max_connections ($maxc) must be more than superuser_reserved_connections ($sup) plus the GM's reserved_connections ($RESERVED); PostgreSQL was NOT restarted."
            exit 1
        fi ;;
esac
# 2. pg_hba.conf parses (checked through the running server, if any).
if hba=$(as_postgres psql -X -w -q -A -t -h /run/postgresql -p 5432 -d postgres -c \
        "SELECT file_name || ':' || line_number || ': ' || error FROM pg_hba_file_rules WHERE error IS NOT NULL" 2>/dev/null) \
   && [ -n "$hba" ]; then
    echo "gm-restart-db: pg_hba.conf has errors; PostgreSQL was NOT restarted:"
    printf '%s\n' "$hba" | sed 's/^/  /'
    exit 1
fi

# 3. Restart under s6 and wait for a new postmaster to accept connections.
old_pid=$(s6-svstat -o pid "$SERVICE" 2>/dev/null || echo -1)
s6-svc -r "$SERVICE" || { echo "gm-restart-db: could not signal the postgres service" >&2; exit 1; }
i=0
while [ "$i" -lt "$WAIT" ]; do
    sleep 1
    i=$((i + 1))
    pid=$(s6-svstat -o pid "$SERVICE" 2>/dev/null || echo -1)
    if [ "$pid" != "$old_pid" ] && [ "$pid" != "-1" ] \
       && pg_isready -q -h /run/postgresql -p 5432 -t 2; then
        echo "gm-restart-db: PostgreSQL restarted and accepting connections."
        exit 0
    fi
done
echo "gm-restart-db: PostgreSQL did not come back within ${WAIT}s." >&2
echo "  Check your last changes (sudo gm-validate), fix them, then run sudo gm-restart-db again." >&2
exit 1
