# sudo rules of the db_audit_gm PostgreSQL node (master spec 9.1).
# DO NOT TAMPER. `player` may run exactly these four wrappers, as root:
# the first three with no arguments; gm-crontab with any, since sudo's
# argument wildcards match spaces too: the wrapper itself accepts exactly
# `-l` or one file and refuses anything else (capture W1 item 8). Nothing
# else.
Defaults env_reset
Defaults secure_path="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Defaults !syslog
Defaults logfile=/run/gm/sudo.log
Defaults lecture=never
Defaults !mail_badpass

player ALL=(root) NOPASSWD: /usr/local/sbin/gm-reload-db "", /usr/local/sbin/gm-restart-db "", /usr/local/sbin/gm-validate "", /usr/local/sbin/gm-crontab
